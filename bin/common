#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
step() {
  local title="$1"
  shift
  if command -v gum >/dev/null 2>&1; then gum style --foreground 42 --bold "▸ $title"; else printf '▸ %s\n' "$title"; fi
  "$@"
}
ensure_runtime() {
  local required
  required="$(sed -n 's/^node = "\(.*\)"/\1/p' .mise.toml)"
  if [ "$(node --version 2>/dev/null || true)" != "v$required" ]; then
    if command -v mise >/dev/null 2>&1; then exec mise exec -- "$0" "$@"; fi
    echo "Run bin/setup to install Node $required." >&2
    exit 1
  fi
}
