---
import Illustrations from '../components/Illustrations.astro';
import '../styles/site.css';
import { messages, languagePath, type Language } from '../lib/i18n';
interface Props { language: Language }
const { language } = Astro.props;
const t = messages[language];
const paths = {ca:languagePath(import.meta.env.BASE_URL,'ca'),es:languagePath(import.meta.env.BASE_URL,'es'),en:languagePath(import.meta.env.BASE_URL,'en')};
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={t.description} />
    <title>{t.pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400&family=Young+Serif&display=swap" />
    <script is:inline define:vars={{language,paths}}>
      // Only the neutral entry URL follows a saved preference. Explicit language links win.
      if (language === 'ca' && new URLSearchParams(location.search).get('lang') !== 'ca') {
        try {
          const saved = localStorage.getItem('llibres-language');
          if (saved === 'es' || saved === 'en') location.replace(paths[saved] + location.search + location.hash);
        } catch {}
      }
    </script>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme;
        try { theme = localStorage.getItem('llibres-theme'); } catch {}
        root.dataset.theme = ['clar', 'fosc'].includes(theme) ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'fosc' : 'clar');
        // Set before the first paint, so the book never jumps from the still layout to the moving one.
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('motion');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#avisos">{t.skip}</a>
    <Illustrations />
    <div class="lamplight" aria-hidden="true"></div>
    <div class="frame">
      <header class="site-header">
        <a class="brand" href={paths[language]}><span>Els Llibres</span><small>{t.school}</small></a>
        <div class="header-right"><details class="language-picker"><summary aria-label="Idioma / Language"><span>{language.toUpperCase()}</span><svg class="language-chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg></summary><nav class="paper" aria-label="Idioma / Language">
          <a href={`${paths.ca}?lang=ca`} data-language="ca" lang="ca" hreflang="ca" aria-current={language === 'ca' ? 'page' : undefined}>Català</a>
          <a href={paths.es} data-language="es" lang="es" hreflang="es" aria-current={language === 'es' ? 'page' : undefined}>Castellano</a>
          <a href={paths.en} data-language="en" lang="en" hreflang="en" aria-current={language === 'en' ? 'page' : undefined}>English</a>
        </nav></details>
          <button id="theme-toggle" type="button" hidden aria-label={t.dark} data-dark={t.dark} data-light={t.light}>
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 13h14l-3-8h-8z"/><path class="bulb" d="M13.5 13a2.5 2.5 0 0 0 5 0" stroke-width="1.5"/>
              <path d="M16 5V2"/><g class="pull-cord"><path d="M21.5 13v6" stroke-dasharray="1.4 1.6"/><circle cx="21.5" cy="20.5" r="1.3"/></g>
              <path d="M11 29h10M16 29v-9"/>
            </svg>
          </button>
        </div>
      </header>
      <main><slot /></main>
      <footer class="back-cover"><span class="the-end" aria-hidden="true">{t.theEnd}</span><p>{t.footer}</p><p>{t.credits}</p></footer>
    </div>
    <slot name="overlays" />
    <script>
      function updateLanguageLinks() {
        document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
          const url = new URL(link.href);
          url.hash = location.hash;
          link.href = url.href;
        });
      }
      updateLanguageLinks();
      addEventListener('hashchange', updateLanguageLinks);
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach(link => {
        link.addEventListener('click', () => {
          updateLanguageLinks();
          try { localStorage.setItem('llibres-language', link.dataset.language!); } catch {}
        });
      });
      const picker = document.querySelector<HTMLDetailsElement>('.language-picker')!;
      document.addEventListener('click', event => { if (!picker.contains(event.target as Node)) picker.open = false; });
      // The desk lamp switches between day and night.
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!;
      const system = matchMedia('(prefers-color-scheme: dark)');
      let manuallySelected = false;
      try { manuallySelected = ['clar', 'fosc'].includes(localStorage.getItem('llibres-theme') || ''); } catch {}
      function updateLabel() {
        toggle.setAttribute('aria-label', document.documentElement.dataset.theme === 'fosc' ? toggle.dataset.light! : toggle.dataset.dark!);
      }
      toggle.hidden = false;
      updateLabel();
      toggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'fosc' ? 'clar' : 'fosc';
        document.documentElement.dataset.theme = theme;
        manuallySelected = true;
        try { localStorage.setItem('llibres-theme', theme); } catch {}
        updateLabel();
      });
      system.addEventListener('change', event => {
        if (!manuallySelected) {
          document.documentElement.dataset.theme = event.matches ? 'fosc' : 'clar';
          updateLabel();
        }
      });
    </script>
  </body>
</html>
