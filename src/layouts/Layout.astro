---
import Book from '../components/Book.astro';
import '../styles/site.css';
---
<!doctype html>
<html lang="ca">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content="El tauler de les famílies d’I4B, la classe dels Llibres. Avisos de la classe i de l’Escola La Mar Bella." />
    <title>Els Llibres · El tauler d’I4B</title>
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('llibres-theme'); } catch {}
        document.documentElement.dataset.theme = ['clar', 'fosc'].includes(theme) ? theme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'fosc' : 'clar');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#avisos">Ves als avisos</a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={import.meta.env.BASE_URL}><span class="brand-mark"><Book /></span><span>Els Llibres<small>I4B · Escola La Mar Bella</small></span></a>
        <div class="header-right"><span class="course">Curs 2026–27</span><button id="theme-toggle" hidden aria-label="Activa el mode fosc">
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg>
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
        </button></div>
      </header>
      <main><slot /></main>
      <footer><Book /><p>Un petit tauler per estar al dia.<span>Preparat amb cura per les delegades d’I4B.</span></p><span class="footer-class">I4B / LLIBRES</span></footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle')!;
      const system = matchMedia('(prefers-color-scheme: dark)');
      let manuallySelected = false;
      try { manuallySelected = ['clar', 'fosc'].includes(localStorage.getItem('llibres-theme') || ''); } catch {}
      function updateLabel() {
        toggle.setAttribute('aria-label', `Activa el mode ${document.documentElement.dataset.theme === 'fosc' ? 'clar' : 'fosc'}`);
      }
      toggle.hidden = false;
      updateLabel();
      toggle.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'fosc' ? 'clar' : 'fosc';
        document.documentElement.dataset.theme = theme;
        manuallySelected = true;
        try { localStorage.setItem('llibres-theme', theme); } catch {}
        updateLabel();
      });
      system.addEventListener('change', event => {
        if (!manuallySelected) {
          document.documentElement.dataset.theme = event.matches ? 'fosc' : 'clar';
          updateLabel();
        }
      });
    </script>
  </body>
</html>
