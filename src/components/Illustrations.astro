    <pattern id="endpaper" width="20" height="20" patternUnits="userSpaceOnUse"><path d="M2 14q2.5-3 5 0t5 0" fill="none" style="stroke:var(--cloth)" stroke-width=".9" opacity=".35"/><path d="M13 4h5v5h-5z" style="fill:var(--classe)" opacity=".35"/><path d="M15.5 4v5" style="stroke:var(--cloth)" stroke-width=".6" opacity=".35"/></pattern>
    <pattern id="endpaper-back" href="#endpaper" patternTransform="scale(2.9)"/>
    <!-- In autumn the endpapers are plane leaves and chestnuts in place of the waves and squares. -->
    <pattern id="endpaper-autumn" width="30" height="30" patternUnits="userSpaceOnUse">
      <g opacity=".42"><use href="#plane-leaf" x="2" y="1.5" width="12" height="12" transform="rotate(24 8 7.5)" style="--pl:var(--orange);--pl-vein:var(--wood-dark)"/>
      <use href="#plane-leaf" x="16" y="16" width="12" height="12" transform="rotate(-150 22 22)" style="--pl:var(--red);--pl-vein:var(--wood-dark)"/>
      <use href="#plane-leaf" x="3.5" y="19.5" width="7" height="7" transform="rotate(-60 7 23)" style="--pl:var(--classe);--pl-vein:var(--wood-dark)"/>
      <use href="#chestnut" x="20" y="4.5" width="5" height="5"/><use href="#chestnut" x="24.5" y="8" width="3.6" height="3.6" transform="rotate(30 26.3 9.8)"/></g>
    </pattern>
    <pattern id="endpaper-autumn-back" href="#endpaper-autumn" patternTransform="scale(2.4)"/>
