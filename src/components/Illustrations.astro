      <circle cy="-7.4" r="1.55" style="fill:var(--white)"/><circle cx=".2" cy="-7.2" r=".72" style="fill:var(--black)"/>
      <path d="M-1-5.3q1 .8 2 0" style="fill:none;stroke:var(--black);stroke-width:.4;stroke-linecap:round"/>
    </symbol>
    {/* Their teacher, taller and slimmer than the children. Her arms are drawn on the cover, where one of them waves. */}
    <symbol id="teacher" viewBox="0 0 14 27" overflow="visible">
      <rect x="5.1" y="19.6" width="1.7" height="7" rx=".85" style="fill:var(--black)"/><rect x="7.2" y="19.6" width="1.7" height="7" rx=".85" style="fill:var(--black)"/>
      <path d="M7 7.5c-3.1 0-4.2 2.5-4.9 13.3h9.8C11.2 10 10.1 7.5 7 7.5z" style="fill:var(--cloth)"/>
      <path d="M5.7 7.8 7 9.5l1.3-1.7" style="fill:none;stroke:var(--white);stroke-width:.5;stroke-linejoin:round;stroke-linecap:round"/>
      <circle cx="7" cy="4.3" r="2.5" style="fill:var(--skin-6)"/>
      <path d="M4 7C3.6 4.6 3.9 1.3 7 1.3s3.4 3.3 3 5.7H9C9.2 5.6 9.1 4.3 8.6 3.5 7.6 3.1 6.2 3.3 5.4 3.7 5 4.5 4.9 5.8 5 7z" style="fill:var(--hair-5)"/>
    </symbol>
    <filter id="piece-shadow" x="-10%" y="-10%" width="130%" height="130%"><feDropShadow dx=".45" dy=".75" stdDeviation=".45" flood-color="#281c0a" flood-opacity=".28"/></filter>
    <!-- The endpapers inside both covers. The front one is drawn in its cover's units; the back one
