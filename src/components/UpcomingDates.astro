---
import type { CollectionEntry } from 'astro:content';
import { leaf, fullDate, dayAndTime, menusLabel } from '../lib/date-labels';
import { messages, type Language } from '../lib/i18n';
interface Props { notices: CollectionEntry<'notices'>[]; menuMonth?: string; language: Language }
const { notices, menuMonth, language } = Astro.props;
const t = messages[language];
const events = notices.filter(notice => notice.data.event).sort((a,b) => a.data.event!.start.localeCompare(b.data.event!.start));
---
<div class="sheet paper upcoming" id="dates">
  <span class="bookmark" aria-hidden="true"></span>
  <h2 id="upcoming-title">{t.upcoming}</h2>
  {events.length > 0 && <div class="upcoming-list" id="upcoming-list">
    {events.map(({id,data}) => {
      const event = data.event!;
      const { month, day } = leaf(event, language);
      return <a class={`upcoming-event ${data.category}`} href={`#avis-${id}`} data-end={event.end} data-all-day={String(!!event.allDay)}>
        <span class="date-leaf" aria-hidden="true"><b>{month}</b><span>{day}</span></span>
        <span class="upcoming-text"><span class="upcoming-title">{event.title || data.title}</span><span class="upcoming-when"><span class="sr-only"><time datetime={event.start}>{fullDate(event.start, language)}</time>, </span>{dayAndTime(event, language)}</span></span>
      </a>;
    })}
  </div>}
  <div class="upcoming-empty" hidden={events.length > 0}>
    <span class="date-leaf blank" aria-hidden="true"><b></b><span>–</span></span>
    <p>{t.noDates}</p>
    <p>{t.noDatesBody}</p>
  </div>
  <button class="more-dates" type="button" aria-expanded="false" aria-controls="upcoming-list" data-one={t.moreDate} data-many={t.moreDates} data-fewer={t.fewerDates} hidden><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4"/></svg><span></span></button>
  <div class="page-links">
    <a class="school-calendar" href="https://lamarbella.cat/calendari-escolar/" target="_blank" rel="noopener noreferrer">{t.schoolCalendar}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12"/></svg><span class="sr-only"> ({t.newTab.toLocaleLowerCase(language)})</span></a>
    {menuMonth && <a class="menus-link" href="#menus">{menusLabel(menuMonth, language)}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v11M3.5 9 8 13.5 12.5 9"/></svg></a>}
  </div>
</div>
<script>
  const motion = document.documentElement.classList.contains('motion');
  const page = document.getElementById('dates')!;
  const rows = Array.from(page.querySelectorAll<HTMLAnchorElement>('.upcoming-event'));

  // Static hosting: expire dates without waiting for another deployment.
  function refreshDates() {
    const today = new Intl.DateTimeFormat('en-CA', {timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
    rows.forEach(row => {
      row.hidden = row.dataset.allDay === 'true' ? row.dataset.end! <= today : Date.parse(row.dataset.end!) <= Date.now();
    });
    page.dispatchEvent(new Event('dates-change'));
  }
  refreshDates();
  setInterval(refreshDates, 60_000);
  document.addEventListener('visibilitychange', refreshDates);

  // A date turns the pages to its notice and opens it. Without JavaScript the anchor link still
  // reaches the card. The menus link is a plain jump to the back of the book: turning every page
  // on the way there was distracting.
  const riffle = document.querySelector<HTMLElement>('.riffle');
  const leaves = Array.from(riffle?.children ?? []) as HTMLElement[];
  function arrive(card: HTMLElement) {
    card.scrollIntoView({ block:'start' });
    const details = card.querySelector<HTMLDetailsElement>('details');
    if (details) details.open = true;
    card.classList.add('highlight');
    setTimeout(() => card.classList.remove('highlight'), 2600);
    card.dispatchEvent(new Event('llibres:arrive', { bubbles:true }));
    card.querySelector<HTMLElement>('summary')?.focus({ preventScroll:true });
  }
  rows.forEach(row => row.addEventListener('click', event => {
    const card = document.querySelector<HTMLElement>(row.getAttribute('href')!);
    if (!card) return;
    event.preventDefault();
    if (card.hidden) document.dispatchEvent(new Event('llibres:show-all'));
    row.blur();
    if (!motion || !riffle) { arrive(card); return; }
    leaves.forEach((leaf, index) => { leaf.style.animationDelay = `${120 + index * 85}ms`; leaf.style.zIndex = String(10 - index); });
    riffle.classList.remove('turning');
    void riffle.offsetWidth;
    riffle.classList.add('turning');
    requestAnimationFrame(() => arrive(card));
    setTimeout(() => riffle.classList.remove('turning'), 120 + leaves.length * 85 + 700);
  }));
</script>
