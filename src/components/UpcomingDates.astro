---
import type { CollectionEntry } from 'astro:content';
import CalendarLinks from './CalendarLinks.astro';
import { eventTimeLabel } from '../lib/calendar';
import { categories } from '../lib/categories';
interface Props { notices: CollectionEntry<'notices'>[] }
const { notices } = Astro.props;
const events = notices.filter(notice => notice.data.event).sort((a,b) => a.data.event!.start.localeCompare(b.data.event!.start));
const format = (value: string, options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat('ca-ES', { ...options, timeZone:'Europe/Madrid' }).format(new Date(value.length === 10 ? value + 'T12:00:00Z' : value));
---
{events.length > 0 && <section class="upcoming" aria-labelledby="upcoming-title">
  <h2 id="upcoming-title">Properes dates</h2>
  {events.map(({id,data}) => {
    const event = data.event!;
    return <details class="upcoming-event" data-end={event.end} data-all-day={String(!!event.allDay)}>
      <summary>
        <time datetime={event.start}><strong>{format(event.start,{day:'numeric'})}</strong><span>{format(event.start,{month:'short'})}</span></time>
        <span class="upcoming-text"><span class={`upcoming-category ${data.category}`}>{categories[data.category]}</span><strong>{event.title || data.title}</strong><span class="upcoming-time">{format(event.start,{weekday:'long'})} · {eventTimeLabel(event)}</span></span>
        <span class="expand" aria-hidden="true">+</span>
      </summary>
      <div class="upcoming-body"><p>{event.allDay ? event.description : event.location}</p><h3>Afegeix-ho al teu calendari</h3><CalendarLinks id={id} title={data.title} event={event} /></div>
    </details>;
  })}
</section>}
<script>
  // Static hosting: expire dates without waiting for another deployment.
  function refreshDates() {
    const today = new Intl.DateTimeFormat('en-CA', {timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
    document.querySelectorAll<HTMLElement>('.upcoming-event').forEach(row => {
      row.hidden = row.dataset.allDay === 'true' ? row.dataset.end! <= today : Date.parse(row.dataset.end!) <= Date.now();
    });
    const upcoming = document.querySelector<HTMLElement>('.upcoming');
    if (upcoming) upcoming.hidden = !upcoming.querySelector('.upcoming-event:not([hidden])');
  }
  refreshDates();
  setInterval(refreshDates, 60_000);
  document.addEventListener('visibilitychange', refreshDates);
</script>
