---
import type { CollectionEntry } from 'astro:content';
import { eventTimeLabel } from '../lib/calendar';
import { messages, type Language } from '../lib/i18n';
interface Props { notices: CollectionEntry<'notices'>[]; language: Language }
const { notices, language } = Astro.props;
const t = messages[language];
const events = notices.filter(notice => notice.data.event).sort((a,b) => a.data.event!.start.localeCompare(b.data.event!.start));
const format = (value: string, options: Intl.DateTimeFormatOptions) => new Intl.DateTimeFormat(language, { ...options, timeZone:'Europe/Madrid' }).format(new Date(value.length === 10 ? value + 'T12:00:00Z' : value));
---
{events.length > 0 && <section class="upcoming" aria-labelledby="upcoming-title">
  <h2 id="upcoming-title">{t.upcoming}</h2>
  {events.map(({id,data}) => {
    const event = data.event!;
    return <a class={`upcoming-event ${data.category}`} href={`#avis-${id}`} data-end={event.end} data-all-day={String(!!event.allDay)}>
      <time class="upcoming-day" datetime={event.start}><strong>{format(event.start,{day:'numeric'})}</strong><span>{format(event.start,{month:'short'}).replace(/\.$/,'')}</span></time>
      <span class="upcoming-text"><strong class="upcoming-when">{eventTimeLabel(event, language)}<small>{format(event.start,{weekday:'long'})}</small></strong><span class="upcoming-title">{event.title || data.title}</span></span>
      <span class="upcoming-arrow" aria-hidden="true"></span>
    </a>;
  })}
</section>}
<script>
  // Static hosting: expire dates without waiting for another deployment.
  function refreshDates() {
    const today = new Intl.DateTimeFormat('en-CA', {timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
    document.querySelectorAll<HTMLElement>('.upcoming-event').forEach(row => {
      row.hidden = row.dataset.allDay === 'true' ? row.dataset.end! <= today : Date.parse(row.dataset.end!) <= Date.now();
    });
    const upcoming = document.querySelector<HTMLElement>('.upcoming');
    if (upcoming) upcoming.hidden = !upcoming.querySelector('.upcoming-event:not([hidden])');
  }
  refreshDates();
  setInterval(refreshDates, 60_000);
  document.addEventListener('visibilitychange', refreshDates);

  // A date row opens its notice. Without JavaScript the anchor link still reaches the card.
  document.querySelectorAll<HTMLAnchorElement>('.upcoming-event').forEach(row => row.addEventListener('click', event => {
    const card = document.querySelector<HTMLElement>(row.getAttribute('href')!);
    if (!card) return;
    event.preventDefault();
    if (card.hidden) document.querySelector<HTMLButtonElement>('.filters button[data-filter="tot"]')?.click();
    const details = card.querySelector<HTMLDetailsElement>('details');
    if (details) details.open = true;
    row.blur();
    card.scrollIntoView({block:'start', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'});
    card.classList.add('highlight');
    card.querySelector<HTMLElement>('summary')?.focus({preventScroll:true});
    setTimeout(() => card.classList.remove('highlight'), 2500);
  }));
</script>
