---
// Christmas at school, on the square in front of it: a fir garland swags along the school's roof
// and a wreath hangs on its door. A bare plane tree has two eyes peeking out of a hollow in its
// trunk, for the families watching the trees. Three children in Christmas jumpers sing hand in
// hand while notes rise, with motion, from their song. By the entrance stands the food collection
// box, full of tins, pasta and milk; in front, the sixth grade's hamper with a bow and a raffle
// ticket, and a present for the Three Kings toy. The box's label is translated; nothing else has
// words.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const label = { ca:['Recollida', 'd’aliments'], es:['Recogida', 'de alimentos'], en:['Food', 'collection'] }[Astro.props.language];
// The garland hangs from the roof in three swags, with a bow where they meet and a bauble under each.
const hooks = [20, 40, 60, 80] as const;
const baubles = [[30, 'red'], [50, 'yellow'], [70, 'escola']] as const;
// The singers: where each stands, and their jumper, skin and hair.
const singers = [[1, 'red', 'skin-2', 'hair-1'], [13, 'grass-dark', 'skin-5', 'hair-4'], [25, 'sea', 'skin-3', 'hair-2']] as const;
// Their notes, rising one after another.
const notes = [[9, 4, ''], [20.4, 3.2, 'b'], [30, 4.4, 'c']] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="89" cy="10" r="3.4" style="fill:var(--sun)"/><g class="night"><circle cx="89" cy="10" r="3.4" style="fill:var(--sun)"/><circle cx="90.6" cy="9.1" r="3" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="3" y="5" width="14" height="5.6"/><use href="#cloud" x="83" y="20" width="12" height="4.8"/></g>
  <use href="#school-building" x="-12.5" y="-22" width="125" height="112.5"/>
  {/* The garland along the roof, its bows and baubles, and the wreath on the door. */}
  <path d={`M${hooks[0]} 22.4${hooks.slice(1).map(x => `Q${x - 10} 26.6 ${x} 22.4`).join('')}`} style="fill:none;stroke:var(--grass-dark);stroke-width:1.5;stroke-linecap:round"/>
  <path d={`M${hooks[0]} 22.4${hooks.slice(1).map(x => `Q${x - 10} 26.6 ${x} 22.4`).join('')}`} style="fill:none;stroke:var(--grass-light);stroke-width:.5;stroke-dasharray:.6 1.2"/>
  {baubles.map(([x, colour]) => <g><path d={`M${x} 24.5v1.2`} style="stroke:var(--black);stroke-width:.2"/><circle cx={x} cy="26.5" r=".9" style={`fill:var(--${colour})`}/><circle cx={x - .3} cy="26.2" r=".25" style="fill:var(--white);opacity:.7"/></g>)}
  {hooks.map(x => <g style="fill:var(--red)"><path d={`M${x} 22.4l-1.8-1v2z M${x} 22.4l1.8-1v2z`}/><path d={`M${x} 22.4l-.9 2.6M${x} 22.4l.9 2.6`} style="stroke:var(--red);stroke-width:.4"/><circle cx={x} cy="22.4" r=".5"/></g>)}
  <circle cx="50" cy="38.4" r="2.2" style="fill:none;stroke:var(--grass-dark);stroke-width:1.1"/>
  <g style="fill:var(--red)"><circle cx="48.3" cy="37.4" r=".35"/><circle cx="51.8" cy="37.2" r=".35"/><circle cx="50.2" cy="36.2" r=".35"/><path d="M50 40.4l-1.3-.8v1.6zM50 40.4l1.3-.8v1.6z"/></g>
  <rect y="47.4" width="100" height="2.6" style="fill:var(--wall-dark)"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--wall-dark)"/>
  <path d="M0 8h100M0 17h100M0 27h100M10 0v40M30 0v40M50 0v40M70 0v40M90 0v40" style="stroke:var(--wall);stroke-width:.4;opacity:.7"/>
</svg>
  <div class="piece" style="--x:3;--y:9;--w:22;--ar:20/34;--d:0"><svg viewBox="0 0 20 34">
    {/* A bare plane tree, and two eyes peeking out of the hollow in its trunk. */}
    <path d="M10 17.4 5.2 9.4 3 4M10 17 14.6 8.8 17.2 3.4M10 16.6 9.6 6 10.4 1" style="fill:none;stroke:var(--wood);stroke-width:1.2;stroke-linecap:round"/>
    <path d="M5.2 9.4 2.2 8M4 6.6l1.8-2.4M14.6 8.8l3.2-.6M15.8 6.4 14.4 4M9.6 6 7.4 3M9.8 4.4l2-1.6" style="fill:none;stroke:var(--wood);stroke-width:.6;stroke-linecap:round"/>
    <g style="fill:var(--orange)"><ellipse cx="2.4" cy="7.8" rx=".7" ry=".45" transform="rotate(30 2.4 7.8)"/><ellipse cx="17.8" cy="8" rx=".7" ry=".45" transform="rotate(-20 17.8 8)"/></g>
    <path d="M7.4 34c.6-6 .6-11 1.2-17.4h2.8c.6 6.4.6 11.4 1.2 17.4z" style="fill:var(--wood)"/>
    <g style="fill:var(--cream);opacity:.8"><ellipse cx="9.6" cy="29.6" rx=".7" ry="1.2"/><ellipse cx="10.6" cy="19.4" rx=".5" ry=".9"/><ellipse cx="9.4" cy="26" rx=".4" ry=".7"/></g>
    <ellipse cx="10" cy="23" rx="1.6" ry="2.1" style="fill:var(--black)"/>
    <g style="fill:var(--white)"><circle cx="9.3" cy="22.6" r=".65"/><circle cx="10.7" cy="22.6" r=".65"/></g>
    <g style="fill:var(--black)"><circle cx="9.55" cy="22.75" r=".32"/><circle cx="10.95" cy="22.75" r=".32"/></g>
  </svg></div>
  <div class="piece" style="--x:74;--y:14;--w:20;--ar:20/17;--d:.1"><svg viewBox="0 0 20 17">
    {/* The food collection box by the entrance, full of tins, pasta and milk. */}
    <path d="M3.4 7 4.4 3.8h11.2L16.6 7z" style="fill:var(--cardboard);opacity:.75"/>
    <rect x="4" y="3.6" width="3" height="4.4" rx=".4" style="fill:var(--steel)"/><rect x="4" y="4.8" width="3" height="1.6" style="fill:var(--red)"/>
    <path d="M7.6 2.4h3.4l.4 5.6H7.2z" style="fill:var(--yellow)"/><rect x="8.3" y="3.6" width="2" height="1.4" rx=".3" style="fill:var(--white);opacity:.8"/>
    <path d="M12 3.4 13.2 2l1.2 1.4V8H12z" style="fill:var(--white)"/><path d="M12 3.4 13.2 2l1.2 1.4z" style="fill:var(--escola)"/>
    <rect x="14.6" y="4.8" width="2.4" height="3.2" rx=".4" style="fill:var(--steel)"/><rect x="14.6" y="5.6" width="2.4" height="1.2" style="fill:var(--grass)"/>
    <path d="M2 7 .4 4.6l3.8.4L5 7zM18 7l1.6-2.4-3.8.4L15 7z" style="fill:var(--cardboard)"/>
    <rect x="2" y="7" width="16" height="10" style="fill:var(--cardboard)"/><rect x="2" y="7" width="16" height=".6" style="fill:var(--wood-dark);opacity:.35"/>
    <rect x="3" y="8.8" width="14" height="6.4" rx=".3" style="fill:var(--white)"/>
    <text x="10" y="11.4" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:1.8px;fill:var(--black)">{label[0]}</text>
    <text x="10" y="13.8" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:1.8px;fill:var(--black)">{label[1]}</text>
  </svg></div>
  <div class="piece" style="--x:31;--y:25;--w:36;--ar:38/22;--d:.18"><svg viewBox="0 0 38 22">
    {/* Three children in Christmas jumpers sing hand in hand, and their notes rise. */}
    {notes.map(([x, y, delay]) => <g class={`smoke part ${delay}`.trim()} style="fill:var(--black);transform-origin:50% 50%"><path d={`M${x + .6} ${y}V${y - 3}l1.6.8`} style="fill:none;stroke:var(--black);stroke-width:.3"/><ellipse cx={x} cy={y} rx=".75" ry=".55" transform={`rotate(-20 ${x} ${y})`}/></g>)}
    <g class="hop">
      {singers.map(([x, clothes, skin, hair]) => <g>
        <use href="#child" x={x} y="4" width="12" height="18" style={`--clothes:var(--${clothes});--skin:var(--${skin});--hair:var(--${hair})`}/>
        <path d={`M${x + 2.8} 14.6l.8-.8.8.8.8-.8.8.8.8-.8.8.8.8-.8.8.8`} style="fill:none;stroke:var(--white);stroke-width:.35"/>
        <g style="fill:var(--white)"><circle cx={x + 4.6} cy="12.4" r=".28"/><circle cx={x + 7.4} cy="12.4" r=".28"/><circle cx={x + 6} cy="16.4" r=".28"/></g>
      </g>)}
      <path d="M4.8 12.2Q3.6 13.6 3.4 16" style="fill:none;stroke:var(--skin-2);stroke-width:1.1;stroke-linecap:round"/>
      <path d="M9.2 12.2Q11.6 13 13 15" style="fill:none;stroke:var(--skin-2);stroke-width:1.1;stroke-linecap:round"/>
      <path d="M16.8 12.2Q14.4 13 13 15M21.2 12.2Q23.6 13 25 15" style="fill:none;stroke:var(--skin-5);stroke-width:1.1;stroke-linecap:round"/>
      <path d="M28.8 12.2Q26.4 13 25 15M33.2 12.2Q34.4 13.6 34.6 16" style="fill:none;stroke:var(--skin-3);stroke-width:1.1;stroke-linecap:round"/>
    </g>
  </svg></div>
  <div class="piece" style="--x:13;--y:33;--w:17;--ar:17/16;--d:.28"><svg viewBox="0 0 17 16">
    {/* The sixth grade's hamper, wrapped with a bow, and a raffle ticket. */}
    <path d="M3 8.4Q7.6-1.6 12.2 8.4" style="fill:none;stroke:var(--wood-dark);stroke-width:.8"/>
    <rect x="4" y="2.6" width="2" height="6.4" rx=".4" style="fill:var(--grass-dark)"/><rect x="4.4" y="1.4" width="1.2" height="1.6" style="fill:var(--grass-dark)"/><rect x="4" y="5" width="2" height="1.8" style="fill:var(--yellow)"/>
    <rect x="6.6" y="4.6" width="4.2" height="3.4" rx=".3" transform="rotate(-8 8.7 6.3)" style="fill:var(--cream)"/><rect x="6.6" y="5.8" width="4.2" height=".8" transform="rotate(-8 8.7 6.3)" style="fill:var(--red)"/>
    <rect x="10.4" y="5.4" width="2.4" height="3.2" rx=".5" style="fill:var(--orange)"/><rect x="10.2" y="4.8" width="2.8" height="1" rx=".3" style="fill:var(--red)"/>
    <path d="M1.6 8.4h12l-1.2 6.6H2.8z" style="fill:var(--wood)"/>
    <path d="M2 10.4h11.2M2.4 12.6h10.4M4.6 8.4l.4 6.6M7.6 8.4V15M10.6 8.4l-.4 6.6" style="stroke:var(--wood-dark);stroke-width:.35;opacity:.8"/>
    <path d="M1.2 8.6Q7.6 0 14 8.6" style="fill:var(--sky-light);opacity:.3"/>
    <path d="M7.6 3.4l-2.2-1.4v2.8zM7.6 3.4l2.2-1.4v2.8z" style="fill:var(--red)"/><circle cx="7.6" cy="3.4" r=".6" style="fill:var(--red)"/>
    <g transform="rotate(12 15 13.4)"><rect x="13.2" y="11.8" width="3.6" height="3.2" rx=".2" style="fill:var(--white)"/><path d="M14.2 11.8V15" style="stroke:var(--black);stroke-width:.2;stroke-dasharray:.3 .3"/><path d="M14.8 12.8h1.4M14.8 13.6h1.4M14.8 14.4h.9" style="stroke:var(--escola);stroke-width:.3"/></g>
  </svg></div>
  <div class="piece" style="--x:76;--y:34;--w:9;--ar:9/9;--d:.36"><svg viewBox="0 0 9 9">
    {/* A present, for the toy from the Three Kings. */}
    <rect x="1" y="3.6" width="7" height="5.4" rx=".3" style="fill:var(--red)"/><rect x=".6" y="2.6" width="7.8" height="1.4" rx=".3" style="fill:var(--red)"/>
    <path d="M4.5 2.6V9M.6 3.3h7.8" style="stroke:var(--yellow);stroke-width:.8"/>
    <path d="M4.5 2.6C3 .4 1.4 1.2 2.2 2.2zM4.5 2.6C6 .4 7.6 1.2 6.8 2.2z" style="fill:none;stroke:var(--yellow);stroke-width:.6"/>
  </svg></div>
</div>
