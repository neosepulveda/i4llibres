---
// The district's cross-country race at CEM La Mar Bella, by the sea: the finish arch with its
// chequered strip, the CEEB's tent with race numbers and chips on the table, a child with a race
// number running hand in hand with a grown-up in the family race, the flags marking the small
// green circuit, and a sign for its 400 metres.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const finish = { ca:'Arribada', es:'Llegada', en:'Finish' }[Astro.props.language];
// The chequered strip under the arch's banner: the black squares of its two rows.
const squares = Array.from({ length:15 }, (_, i) => i);
// The tent's valance, in the school's green and white.
const valance = Array.from({ length:9 }, (_, i) => ({ x:i * 3, colour:i % 2 ? 'white' : 'escola' }));
// Flags along the green circuit: where each stake stands and how tall it is.
const flags = [[2, 9], [9, 8], [16, 9.4]] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="16" cy="10" r="4.4" style="fill:var(--sun)"/><g class="night"><circle cx="16" cy="10" r="4.4" style="fill:var(--sun)"/><circle cx="18.2" cy="8.8" r="3.9" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="34" y="6" width="17" height="7"/><use href="#cloud" x="70" y="10" width="13" height="5"/></g>
  <rect y="25" width="100" height="7" style="fill:var(--sea)"/><path d="M0 25.4h100" style="stroke:var(--foam);stroke-width:.5;opacity:.8"/>
  <path d="M8 28h6M30 27h8M58 28.4h5M82 27.2h7" style="stroke:var(--sea-light);stroke-width:.5;stroke-linecap:round"/>
  <path d="M0 50V31c14-2 30-2 46 0s34 2 54-1v20z" style="fill:var(--grass-light)"/>
  {/* A floodlight over the sports ground. */}
  <rect x="73.6" y="8" width=".9" height="23" style="fill:var(--steel)"/><rect x="71" y="5.4" width="6" height="3.2" rx=".4" style="fill:var(--steel)"/>
  <g style="fill:var(--sky-light)"><circle cx="72.6" cy="7" r=".7"/><circle cx="74.1" cy="7" r=".7"/><circle cx="75.5" cy="7" r=".7"/></g>
  <use href="#tree" x="3" y="15" width="9" height="15"/><use href="#tree" x="87" y="13" width="10" height="17"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--grass)"/>
  <rect y="2" width="100" height="6" style="fill:var(--red);opacity:.7"/><path d="M0 4h100M0 6h100" style="stroke:var(--white);stroke-width:.3;opacity:.8"/>
  <path d="M6 36C18 22 36 14 50 12.6S84 18 94 32" style="fill:none;stroke:var(--white);stroke-width:.7;stroke-dasharray:2 1.4;opacity:.75"/>
  <rect x="31" y="11.8" width="38" height="1.2" style="fill:var(--white)"/>
</svg>
  <div class="piece" style="--x:30;--y:12;--w:40;--ar:40/28;--d:0"><svg viewBox="0 0 40 28">
    {/* The finish arch: two blown-up posts and a banner, with a chequered strip below it. */}
    <g style="fill:var(--escola)"><rect x="1" y="4" width="4" height="24" rx="2"/><rect x="35" y="4" width="4" height="24" rx="2"/><rect x="0" y="1" width="40" height="8" rx="3"/></g>
    <text x="20" y="6.9" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:4.8px;fill:var(--white)">{finish}</text>
    <rect x="5" y="9" width="30" height="2" style="fill:var(--white)"/>
    <g style="fill:var(--black)">{squares.map(i => <rect x={5 + i * 2} y="9" width="1" height="1"/>)}{squares.map(i => <rect x={6 + i * 2} y="10" width="1" height="1"/>)}</g>
  </svg></div>
  <div class="piece" style="--x:7;--y:22;--w:24;--ar:26/20;--d:.12"><svg viewBox="0 0 26 20">
    {/* The CEEB's tent, where families collect the chip and the race number. */}
    <g style="fill:var(--wood-dark)"><rect x="1.6" y="5" width=".8" height="15"/><rect x="23.6" y="5" width=".8" height="15"/></g>
    <path d="M13 11.2c-2.4 0-3.2 1-3.4 2.6h6.8c-.2-1.6-1-2.6-3.4-2.6z" style="fill:var(--sea)"/>
    <circle cx="13" cy="9.6" r="2" style="fill:var(--skin-2)"/><path d="M11 9.4c0-1.4.9-2.4 2-2.4s2 1 2 2.4c-.5-.5-1.2-.9-2-.9s-1.5.4-2 .9z" style="fill:var(--hair-4)"/>
    <path d="M0 6.4 4 1h18l4 5.4z" style="fill:var(--escola)"/>
    {valance.map(({ x, colour }) => <path d={`M${x - .2} 6.4h3.4v1.6a1.7 1.7 0 0 1-3.4 0z`} style={`fill:var(--${colour})`}/>)}
    <rect x="3" y="13.6" width="20" height="1.4" rx=".3" style="fill:var(--wood)"/><rect x="3.6" y="15" width="18.8" height="5" style="fill:var(--cream)"/><rect x="3.6" y="15" width="18.8" height="1" style="fill:var(--escola)"/>
    <g style="fill:var(--white);stroke:var(--black);stroke-width:.2"><rect x="5" y="11" width="4.4" height="2.6" transform="rotate(-6 7 12)"/><rect x="6" y="10.4" width="4.4" height="2.6" transform="rotate(4 8 12)"/></g>
    <path d="M6.8 11.6h2M7.6 12.4h1.4" style="stroke:var(--escola);stroke-width:.35"/>
    <rect x="16" y="11.2" width="5" height="2.4" rx=".3" style="fill:var(--steel)"/><g style="fill:var(--yellow)"><circle cx="17" cy="12.4" r=".45"/><circle cx="18.5" cy="12.4" r=".45"/><circle cx="20" cy="12.4" r=".45"/></g>
  </svg></div>
  <div class="piece" style="--x:42;--y:31;--w:22;--ar:22/30;--d:.22"><svg viewBox="0 0 22 30">
    {/* The family race: a child with a race number runs hand in hand with a grown-up. */}
    <path d="M.2 23.4h1.8M.6 25.8h1.4" style="stroke:var(--white);stroke-width:.5;stroke-linecap:round;opacity:.8"/>
    <g class="hop">
      <path d="M6.4 21.4 3.6 29M8.2 21.4l3.4 7.2" style="fill:none;stroke:var(--black);stroke-width:1.7;stroke-linecap:round"/>
      <path d="M7.2 9.6c-2.6 0-3.8 2.2-4 6.4l-.2 5.8h8.4l-.2-5.8c-.2-4.2-1.4-6.4-4-6.4z" style="fill:var(--red)"/>
      <path d="M4.4 12.8 2.4 17.4M10 12.8l1.6 5.8" style="fill:none;stroke:var(--skin-3);stroke-width:1.2;stroke-linecap:round"/>
      <circle cx="7.2" cy="6.6" r="2.8" style="fill:var(--skin-3)"/><path d="M4.4 6.6c-.2-2.2 1.2-3.6 2.8-3.6s3 1.4 2.8 3.6c-.4-1-1.6-1.6-2.8-1.6s-2.4.6-2.8 1.6zM4.8 4.6 2 4.8l1.4 2z" style="fill:var(--hair-3)"/>
      <use href="#child" x="10" y="12" width="12" height="18" style="--clothes:var(--classe);--skin:var(--skin-1);--hair:var(--hair-2)"/>
      <path d="M13.6 20.2l-2 -1.6M18.4 20.2l2.2 2.2" style="fill:none;stroke:var(--skin-1);stroke-width:1.2;stroke-linecap:round"/>
      <rect x="13.6" y="20.2" width="4.8" height="3.4" rx=".3" style="fill:var(--white)"/>
      <text x="16" y="22.9" text-anchor="middle" style="font-family:Georgia,serif;font-size:2.4px;fill:var(--black)">22</text>
    </g>
  </svg></div>
  <div class="piece" style="--x:74;--y:24;--w:20;--ar:20/10;--d:.3"><svg viewBox="0 0 20 10">
    {/* The small circuit is the green one: its flags lead the way. */}
    {flags.map(([x, height]) => <g><path d={`M${x} 10V${10 - height}`} style="stroke:var(--black);stroke-width:.35"/><path d={`M${x} ${10 - height}l3.4 1.4-3.4 1.4z`} style="fill:var(--grass-dark)"/></g>)}
  </svg></div>
  <div class="piece" style="--x:15;--y:34;--w:11;--ar:12/12;--d:.4"><svg viewBox="0 0 12 12">
    <rect x="5.4" y="5" width="1.2" height="7" style="fill:var(--wood-dark)"/>
    <rect x="1" y="1" width="10" height="5" rx=".6" style="fill:var(--white);stroke:var(--grass-dark);stroke-width:.6"/>
    <text x="6" y="4.6" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:3px;fill:var(--grass-dark)">400 m</text>
  </svg></div>
</div>
