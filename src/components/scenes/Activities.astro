---
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const monthly = { ca:'cada mes', es:'cada mes', en:'every month' }[Astro.props.language];
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--lilac-light)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <g class="bunting part" style="transform-origin:50% 0"><path d="M0 6q50 10 100 0" style="fill:none;stroke:var(--black);stroke-width:.35;opacity:.6"/>
    <path d="M6 7.2l3 5 3-4.4z" style="fill:var(--classe)"/><path d="M16 8.8l3 5 3-4.2z" style="fill:var(--escola)"/><path d="M26 9.8l3 5 3-4.6z" style="fill:var(--red)"/><path d="M36 10.6l3 5 3-4.8z" style="fill:var(--afa)"/><path d="M46 11l3 5 3-5z" style="fill:var(--sea-light)"/><path d="M56 10.8l3 5 3-5.2z" style="fill:var(--classe)"/><path d="M66 10.2l3 5 3-5z" style="fill:var(--escola)"/><path d="M76 9.2l3 5 3-4.8z" style="fill:var(--red)"/><path d="M86 7.8l3 5 3-4.6z" style="fill:var(--afa)"/></g>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><rect width="100" height="40" style="fill:var(--court)"/><g style="fill:none;stroke:var(--white);stroke-width:.5;opacity:.8"><path d="M4 2h92v36H4zM50 2v36"/><ellipse cx="50" cy="20" rx="8" ry="6"/></g></svg>
  <div class="piece" style="--x:6;--y:6;--w:20;--ar:20/40;--d:0"><svg viewBox="0 0 20 40"><rect x="9" y="10" width="1.8" height="30" style="fill:var(--black)"/><rect x="1" y="1" width="18" height="12" rx=".6" style="fill:var(--white)"/><rect x="6" y="5.6" width="8" height="5" style="fill:none;stroke:var(--red);stroke-width:.7"/><rect x="1" y="1" width="18" height="12" rx=".6" style="fill:none;stroke:var(--black);stroke-width:.5"/><path d="M5.4 13h9.2" style="stroke:var(--orange);stroke-width:1"/><path d="M5.8 13.4l1.4 5M8 13.4l.8 5.4M10 13.4v5.6M12 13.4l-.8 5.4M14.2 13.4l-1.4 5M6.4 16h7.2" style="fill:none;stroke:var(--white);stroke-width:.35"/></svg></div>
  <div class="piece" style="--x:56;--y:5;--w:38;--ar:38/31;--d:.08"><svg viewBox="0 0 38 31"><rect x="1" y="2" width="36" height="29" rx=".8" style="fill:var(--white)"/><rect x="1" y="2" width="36" height="6" style="fill:var(--afa)"/><text x="19" y="6.6" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:3.6px;fill:#fff">{monthly}</text><g style="fill:var(--black)"><circle cx="8" cy="2" r=".9"/><circle cx="30" cy="2" r=".9"/></g>
    <g style="fill:var(--lilac)"><rect x="3" y="10" width="4" height="3.2"/><rect x="7.8" y="10" width="4" height="3.2"/><rect x="12.6" y="10" width="4" height="3.2"/><rect x="17.4" y="10" width="4" height="3.2"/><rect x="22.2" y="10" width="4" height="3.2"/><rect x="27" y="10" width="4" height="3.2"/><rect x="31.8" y="10" width="3.2" height="3.2"/>
    <rect x="3" y="14" width="4" height="3.2"/><rect x="7.8" y="14" width="4" height="3.2"/><rect x="12.6" y="14" width="4" height="3.2"/><rect x="17.4" y="14" width="4" height="3.2"/><rect x="22.2" y="14" width="4" height="3.2"/><rect x="27" y="14" width="4" height="3.2"/><rect x="31.8" y="14" width="3.2" height="3.2"/>
    <rect x="3" y="18" width="4" height="3.2"/><rect x="7.8" y="18" width="4" height="3.2"/><rect x="12.6" y="18" width="4" height="3.2"/><rect x="17.4" y="18" width="4" height="3.2"/><rect x="22.2" y="18" width="4" height="3.2"/><rect x="27" y="18" width="4" height="3.2"/></g>
    <g style="fill:var(--wall-dark)"><rect x="31.8" y="18" width="3.2" height="3.2"/><rect x="3" y="22" width="4" height="3.2"/><rect x="7.8" y="22" width="4" height="3.2"/><rect x="12.6" y="22" width="4" height="3.2"/><rect x="17.4" y="22" width="4" height="3.2"/><rect x="22.2" y="22" width="4" height="3.2"/><rect x="27" y="22" width="4" height="3.2"/><rect x="31.8" y="22" width="3.2" height="3.2"/><rect x="3" y="26" width="4" height="3.2"/><rect x="7.8" y="26" width="4" height="3.2"/></g>
    <circle cx="29" cy="19.6" r="3" style="fill:none;stroke:var(--red);stroke-width:.8"/><text x="29" y="20.8" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:3px;fill:var(--black)">20</text></svg></div>
  <div class="piece" style="--x:28;--y:20;--w:14;--ar:14/24;--d:.2"><svg viewBox="0 0 14 24"><g class="hop"><use href="#child" x="1" y="4" width="12" height="18" style="--clothes:var(--pink);--skin:var(--skin-2);--hair:var(--hair-1)"/><path d="M3.2 11 .6 5.6M10.8 11l2.6-5.4" style="stroke:var(--skin-2);stroke-width:1.2;stroke-linecap:round"/><path d="M1 17.6h12l-1-3H2z" style="fill:var(--pink);opacity:.85"/></g></svg></div>
  <div class="piece" style="--x:42;--y:26;--w:18;--ar:18/22;--d:.28"><svg viewBox="0 0 18 22"><use href="#child" x="1" y="3" width="12" height="18" style="--clothes:var(--classe);--skin:var(--skin-4);--hair:var(--hair-2)"/><g class="ball part"><circle cx="15" cy="18.6" r="2.4" style="fill:var(--red)"/><path d="M12.8 17.8q2.2 1.4 4.4 0M15 16.2v4.8" style="fill:none;stroke:var(--black);stroke-width:.35"/></g></svg></div>
  <div class="piece" style="--x:74;--y:31;--w:12;--ar:12/17;--d:.36"><svg viewBox="0 0 12 17"><path d="M2 17h8v-2.4H2zM3 14.6h6l-.6-4.4c1.6-1.4 2-3.6 1.2-5.6C8.6 2.2 6.2.8 3.8 1.6l.6 1.8-2 1.8.6 1.4 2-.8.6.8-2.2 3.2z" style="fill:var(--cloth)"/><circle cx="6.6" cy="4" r=".6" style="fill:var(--white)"/></svg></div>
  <div class="piece" style="--x:-1;--y:36;--w:102;--ar:102/4;--d:.44"><svg viewBox="0 0 102 4"><path d="M0 4l2-4 2 4 2-3.4 2 3.4 2-4 2 4M40 4l2-3.6 2 3.6 2-4 2 4M84 4l2-4 2 4 2-3.2 2 3.2 2-4 2 4" style="fill:var(--grass-dark)"/></svg></div>
</div>
