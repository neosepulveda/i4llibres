---
// The AFA's Club de Català, "Un cafè i català": a chalkboard with the club's name, a round table
// with two steaming cups and two people talking across it, a plant and a lamp.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const sign = { ca:'Un cafè i català', es:'Un cafè i català', en:'Un cafè i català' }[Astro.props.language];
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sand)"/>
  <rect y="36" width="100" height="14" style="fill:var(--wood);opacity:.45"/><rect y="35.6" width="100" height=".8" style="fill:var(--wood-dark)"/>
  <rect x="30" y="6" width="40" height="22" rx="1" style="fill:var(--wood-dark)"/><rect x="31.6" y="7.6" width="36.8" height="18.8" style="fill:var(--black);opacity:.85"/>
  <text x="50" y="16" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:5px;fill:var(--white)">{sign}</text>
  <path d="M44 20h3v3.4a1.5 1.5 0 0 1-3 0zM47 20.6h1.2a1 1 0 0 1 0 2H47" style="fill:none;stroke:var(--white);stroke-width:.5"/><path d="M45 19.2c-.6-.8.6-1.4 0-2.2M46.2 19.2c-.6-.8.6-1.4 0-2.2" style="fill:none;stroke:var(--white);stroke-width:.4;opacity:.8"/>
  <path d="M52 22.4h6M52 20.4h4" style="stroke:var(--white);stroke-width:.5;stroke-linecap:round;opacity:.7"/>
  <rect x="8" y="10" width="14" height="14" rx=".8" style="fill:var(--wood-dark)"/><rect x="9.2" y="11.2" width="11.6" height="11.6" style="fill:var(--sky)"/><path d="M15 11.2v11.6M9.2 17h11.6" style="stroke:var(--wood-dark);stroke-width:.6"/>
  <circle class="day" cx="18" cy="14" r="1.8" style="fill:var(--sun)"/><g class="night"><circle cx="18" cy="14" r="1.8" style="fill:var(--sun)"/><circle cx="19" cy="13.4" r="1.6" style="fill:var(--sky)"/></g>
  <path d="M84 0v9" style="stroke:var(--black);stroke-width:.5"/><path d="M79 9h10l2 6H77z" style="fill:var(--afa)"/><g class="night glow"><ellipse cx="84" cy="18" rx="6" ry="4" style="fill:#ffd66b;opacity:.3"/></g><circle cx="84" cy="15.6" r="1.2" style="fill:var(--yellow)"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><defs><pattern id="cafe-tiles" width="10" height="10" patternUnits="userSpaceOnUse"><rect width="10" height="10" style="fill:var(--cream)"/><rect width="5" height="5" style="fill:var(--sand-dark);opacity:.5"/><rect x="5" y="5" width="5" height="5" style="fill:var(--sand-dark);opacity:.5"/></pattern></defs><rect width="100" height="40" fill="url(#cafe-tiles)"/></svg>
  <div class="piece" style="--x:8;--y:8;--w:20;--ar:20/30;--d:0"><svg viewBox="0 0 20 30">
    <path d="M10 30c-3.6 0-6-3.4-5.4-11.2C3.4 12.4 5.6 8.4 10 8.4s6.6 4 5.4 10.4c.6 7.8-1.8 11.2-5.4 11.2z" style="fill:var(--afa)"/>
    <circle cx="10" cy="5.4" r="3.4" style="fill:var(--skin-3)"/><path d="M6.6 5.6c-.4-2.8 1.2-4.6 3.4-4.6s3.8 1.8 3.4 4.6c-.4 3.2-1.2 4.8-.6 6.6-1.6-1-4-1-5.6 0 .6-1.8-.2-3.4-.6-6.6z" style="fill:var(--hair-3)"/>
    <path d="M14.8 13 19 17" style="stroke:var(--skin-3);stroke-width:1.4;stroke-linecap:round"/>
  </svg></div>
  <div class="piece" style="--x:28;--y:10;--w:44;--ar:44/28;--d:.12"><svg viewBox="0 0 44 28">
    <g style="fill:none;stroke:var(--white);stroke-width:1.4;stroke-linecap:round"><path class="smoke" d="M13 9c-2-2.4 2-4 0-6.4"/><path class="smoke b" d="M31 9c-2-2.4 2-4 0-6.4"/><path class="smoke c" d="M16 8c-2-2.4 2-4 0-6.4"/></g>
    <ellipse cx="22" cy="14" rx="21" ry="5" style="fill:var(--wood)"/><ellipse cx="22" cy="13.2" rx="19" ry="3.8" style="fill:var(--wood-dark);opacity:.25"/>
    <path d="M20 14.4h4v13.6h-4z" style="fill:var(--wood-dark)"/><ellipse cx="22" cy="27" rx="7" ry="1.4" style="fill:var(--wood-dark)"/>
    <g><path d="M9 8.6h6.4v3.4a1.6 1.6 0 0 1-1.6 1.6h-3.2a1.6 1.6 0 0 1-1.6-1.6z" style="fill:var(--white)"/><path d="M15.4 9.4h1.2a1.4 1.4 0 0 1 0 2.8h-1.2" style="fill:none;stroke:var(--white);stroke-width:.8"/><ellipse cx="12.2" cy="8.8" rx="2.6" ry=".8" style="fill:var(--hair-2)"/><ellipse cx="12.2" cy="15" rx="4.2" ry="1" style="fill:var(--sand-dark)"/></g>
    <g><path d="M27 8.6h6.4v3.4a1.6 1.6 0 0 1-1.6 1.6h-3.2a1.6 1.6 0 0 1-1.6-1.6z" style="fill:var(--red)"/><path d="M33.4 9.4h1.2a1.4 1.4 0 0 1 0 2.8h-1.2" style="fill:none;stroke:var(--red);stroke-width:.8"/><ellipse cx="30.2" cy="8.8" rx="2.6" ry=".8" style="fill:var(--hair-2)"/><ellipse cx="30.2" cy="15" rx="4.2" ry="1" style="fill:var(--sand-dark)"/></g>
    <g><circle cx="22" cy="11" r="2.6" style="fill:var(--white)"/><g style="fill:var(--cardboard)"><circle cx="21" cy="10.4" r=".7"/><circle cx="23" cy="10.8" r=".7"/><circle cx="22" cy="12" r=".6"/></g></g>
  </svg></div>
  <div class="piece" style="--x:70;--y:8;--w:20;--ar:20/30;--d:.22"><svg viewBox="0 0 20 30">
    <path d="M10 30c-3.6 0-6-3.4-5.4-11.2C3.4 12.4 5.6 8.4 10 8.4s6.6 4 5.4 10.4c.6 7.8-1.8 11.2-5.4 11.2z" style="fill:var(--escola)"/>
    <circle cx="10" cy="5.4" r="3.4" style="fill:var(--skin-1)"/><path d="M6.8 5.2c-.2-2.6 1.4-4.2 3.2-4.2s3.4 1.6 3.2 4.2c-.8-1.2-2-1.8-3.2-1.8s-2.4.6-3.2 1.8z" style="fill:var(--hair-4)"/>
    <path d="M5.2 13 1 17" style="stroke:var(--skin-1);stroke-width:1.4;stroke-linecap:round"/>
    <g class="hop"><path d="M14.6 3.4c0-2.2 3.6-2.2 3.6 0 0 1.6-1.8 1.8-1.8 3.2" style="fill:none;stroke:var(--black);stroke-width:.6;stroke-linecap:round"/><circle cx="16.4" cy="8" r=".5" style="fill:var(--black)"/></g>
  </svg></div>
  <div class="piece" style="--x:2;--y:27;--w:12;--ar:12/16;--d:.34"><svg viewBox="0 0 12 16"><path d="M3 16l-1-6h8l-1 6z" style="fill:var(--orange)"/><rect x="1.4" y="9" width="9.2" height="1.6" rx=".4" style="fill:var(--red)"/><g style="fill:var(--grass)"><path d="M6 9C3 7 1 4 3 1c2 1 3 4 3 8z"/><path d="M6 9c3-2 5-5 3-8-2 1-3 4-3 8z"/><path d="M6 9c0-3 .6-6 2-8" style="fill:var(--grass-dark)"/></g></svg></div>
  <div class="piece" style="--x:84;--y:30;--w:14;--ar:14/10;--d:.42"><svg viewBox="0 0 14 10"><rect x="0" y="3" width="14" height="7" rx="1" style="fill:var(--wood-dark)"/><rect x="2" y="4.4" width="10" height="4.4" rx=".6" style="fill:var(--white)"/><path d="M4 6.6h6" style="stroke:var(--black);stroke-width:.5;stroke-linecap:round;opacity:.5"/><g style="fill:var(--cardboard)"><circle cx="3" cy="1.8" r="1.4"/><circle cx="7" cy="1.4" r="1.4"/><circle cx="11" cy="1.8" r="1.4"/></g></svg></div>
</div>
