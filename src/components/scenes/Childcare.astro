---
// A quiet childcare room: a December calendar, the service hours, books and a reading rug.
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sand)"/>
  <rect y="37" width="100" height="13" style="fill:var(--wood);opacity:.4"/>
  <rect x="7" y="7" width="24" height="25" rx="1" style="fill:var(--wood-dark)"/>
  <rect x="8.5" y="8.5" width="21" height="22" style="fill:var(--sky)"/>
  <circle class="day" cx="24" cy="14" r="3" style="fill:var(--sun)"/>
  <g class="night"><circle cx="24" cy="14" r="3" style="fill:var(--sun)"/><circle cx="25.5" cy="12.7" r="2.7" style="fill:var(--sky)"/></g>
  <path d="M19 8.5v22M8.5 20h21" style="stroke:var(--wood-dark);stroke-width:.8"/>
  <g transform="rotate(3 47 18)">
    <rect x="37" y="7" width="20" height="24" rx="1" style="fill:var(--white)"/>
    <rect x="37" y="7" width="20" height="6" rx="1" style="fill:var(--afa)"/>
    <text x="47" y="11.5" text-anchor="middle" style="font-family:Georgia,serif;font-size:4px;fill:var(--white)">12</text>
    <text x="47" y="26" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:12px;fill:var(--black)">21</text>
    <path d="M42 5v4M52 5v4" style="stroke:var(--wood-dark);stroke-width:1;stroke-linecap:round"/>
  </g>
  <rect x="64" y="10" width="30" height="19" rx="1" style="fill:var(--wood-dark)"/>
  <rect x="65.2" y="11.2" width="27.6" height="16.6" rx=".4" style="fill:var(--white)"/>
  <text x="79" y="18" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:4.6px;fill:var(--black)">Biosca</text>
  <text x="79" y="24" text-anchor="middle" style="font-family:Georgia,serif;font-size:3.6px;fill:var(--black)">15:30 – 16:30</text>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--wood)"/>
  <path d="M0 10h100M0 23h100M0 36h100M22 0v10M65 0v10M42 10v13M84 10v13M18 23v13M62 23v13" style="stroke:var(--wood-dark);stroke-width:.35;opacity:.4"/>
  <ellipse cx="59" cy="25" rx="33" ry="13" style="fill:var(--lilac)"/>
  <ellipse cx="59" cy="25" rx="28" ry="10" style="fill:none;stroke:var(--white);stroke-width:.6;opacity:.6"/>
</svg>
  <div class="piece" style="--x:3;--y:13;--w:26;--ar:26/23;--d:0"><svg viewBox="0 0 26 23">
    <rect width="26" height="23" rx=".6" style="fill:var(--wood-dark)"/>
    <rect x="1.5" y="1.5" width="23" height="18" style="fill:var(--sand)"/>
    <g><rect x="3" y="4" width="4" height="13" rx=".5" style="fill:var(--classe)"/><rect x="8" y="2.5" width="4" height="14.5" rx=".5" style="fill:var(--afa)"/><rect x="13" y="5" width="4" height="12" rx=".5" style="fill:var(--escola)"/><rect x="18" y="3.5" width="4.5" height="13.5" rx=".5" style="fill:var(--yellow)"/></g>
    <path d="M3 8h4M8 7h4M13 9h4M18 7.5h4.5" style="stroke:var(--white);stroke-width:.6"/>
    <path d="M3 20v3M23 20v3" style="stroke:var(--wood-dark);stroke-width:2"/>
  </svg></div>
  <div class="piece" style="--x:63;--y:32;--w:24;--ar:24/39;--d:.12"><svg viewBox="0 0 24 39">
    <circle cx="12" cy="6" r="4.4" style="fill:var(--skin-3)"/>
    <path d="M7.6 6c-.6-4.4 2-6 4.4-6s5 1.6 4.4 6c-1.5-2-3-2.5-4.4-2.5S9.1 4 7.6 6z" style="fill:var(--hair-3)"/>
    <path d="M5 31V18c0-5 3-7.5 7-7.5s7 2.5 7 7.5v13z" style="fill:var(--afa)"/>
    <path d="M8 31v7M16 31v7" style="stroke:var(--cloth);stroke-width:3;stroke-linecap:round"/>
    <path d="M6 17 1 23M18 17l3 7" style="stroke:var(--skin-3);stroke-width:2;stroke-linecap:round"/>
  </svg></div>
  <div class="piece" style="--x:34;--y:29;--w:24;--ar:24/26;--d:.24"><svg viewBox="0 0 24 26">
    <use href="#child" x="5" width="14" height="21" style="--clothes:var(--classe);--skin:var(--skin-1);--hair:var(--hair-1)"/>
    <path d="M2 14q5-2 10 1v10q-5-3-10-1z" style="fill:var(--white)"/><path d="M12 15q5-3 10-1v10q-5-2-10 1z" style="fill:var(--cream)"/>
    <path d="M12 15v10M4 17l5 1M4 20l5 1M15 18l5-1M15 21l5-1" style="stroke:var(--wood-dark);stroke-width:.4"/>
  </svg></div>
  <div class="piece" style="--x:76;--y:34;--w:17;--ar:17/12;--d:.36"><svg viewBox="0 0 17 12">
    <rect x="0" y="6" width="6" height="6" rx=".6" style="fill:var(--escola)"/><rect x="7" y="6" width="6" height="6" rx=".6" style="fill:var(--yellow)"/><path d="M4 5 8.5 0 13 5z" style="fill:var(--afa)"/>
  </svg></div>
</div>
