---
// Spare clothes for a rainy day: rain on the playground through the classroom window, the
// children's cloth bags on their pegs, and the full change the class asks for laid out on a bench:
// trousers, a T-shirt, underpants and socks. In front, a child back in from the rain in a
// raincoat and wellies, an open bag, a pair of wet wellies in a puddle and an umbrella drying.
// Pegs along the rail: where each bag hangs, and its colour.
const bags = [[10, 'classe'], [20, 'afa'], [30, 'escola'], [40, 'menjador']] as const;
// Raindrops in the window, as short slanting strokes from where each starts.
const drops = [[60, 10], [65, 15], [70, 9], [74, 17], [79, 11], [84, 16], [89, 10], [62, 21], [86, 22], [77, 23]] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <defs><clipPath id="spare-clothes-window"><rect x="56.5" y="6.5" width="37" height="25"/></clipPath></defs>
  <rect width="100" height="50" style="fill:var(--wall)"/>
  <rect y="36" width="100" height="14" style="fill:var(--wood);opacity:.4"/><rect y="35.6" width="100" height=".8" style="fill:var(--wood-dark)"/>
  <rect x="4" y="8.4" width="42" height="2" rx=".4" style="fill:var(--wood-dark)"/>
  {bags.map(([x, colour]) => <g>
    <circle cx={x} cy="9.4" r=".8" style="fill:var(--black)"/>
    <path d={`M${x - 3} 14.6 ${x} 9.8l3 4.8`} style="fill:none;stroke:var(--black);stroke-width:.35"/>
    <path d={`M${x - 4} 14.4h8l.6 9.6a1 1 0 0 1-1 1h-7.2a1 1 0 0 1-1-1z`} style={`fill:var(--${colour})`}/>
    <rect x={x - 1.6} y="18" width="3.2" height="2" rx=".3" style="fill:var(--white)"/>
  </g>)}
  <rect x="55" y="5" width="40" height="28" rx="1" style="fill:var(--wood-dark)"/>
  <g clip-path="url(#spare-clothes-window)">
    <rect x="56.5" y="6.5" width="37" height="25" style="fill:var(--sky)"/><rect x="56.5" y="6.5" width="37" height="25" style="fill:var(--steel);opacity:.45"/>
    <path d="M56.5 25h37v6.5h-37z" style="fill:var(--sand-dark)"/>
    <ellipse cx="67" cy="28.4" rx="5.4" ry="1.3" style="fill:var(--sea-light);opacity:.8"/><ellipse cx="84" cy="27" rx="3.4" ry=".9" style="fill:var(--sea-light);opacity:.8"/>
    <use href="#tree" x="86" y="11" width="8" height="15"/>
    <g class="clouds"><use href="#cloud" x="57" y="6" width="17" height="7"/><use href="#cloud" x="74" y="5" width="14" height="6"/></g>
    {['rain', 'rain b'].map((rain, i) => <g class={rain} style="fill:none;stroke:var(--sea-light);stroke-width:.5;stroke-linecap:round">
      {drops.map(([x, y]) => <path d={`M${x + i * 2.4} ${y + i * 3}l-.8 2.4`}/>)}
    </g>)}
  </g>
  <path d="M75 6.5v25M56.5 19h37" style="stroke:var(--wood-dark);stroke-width:.8"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--wood)"/>
  <path d="M0 10h100M0 23h100M0 36h100M22 0v10M65 0v10M42 10v13M84 10v13M18 23v13M62 23v13" style="stroke:var(--wood-dark);stroke-width:.35;opacity:.4"/>
  <ellipse cx="73" cy="35" rx="9" ry="3" style="fill:var(--sea-light);opacity:.55"/>
</svg>
  <div class="piece" style="--x:22;--y:15;--w:54;--ar:54/20;--d:0"><svg viewBox="0 0 54 20">
    {/* The change of clothes, laid out on the bench. */}
    <path d="M4 1h9l.8 10h-3.6L8.5 4.6 7.1 11H3.2z" style="fill:var(--cloth)"/><path d="M4 2.4h9" style="stroke:var(--white);stroke-width:.4;opacity:.6"/>
    <path d="M20 1.4l-3.4 2.4 1.8 2.6 1.6-.8V11h9V5.6l1.6.8 1.8-2.6L29 1.4c-.6 1-2 1.6-4.5 1.6s-3.9-.6-4.5-1.6z" style="fill:var(--classe)"/>
    <path d="M35 5h8v1.6c-1.2.4-2 1.6-2.4 3.4h-3.2c-.4-1.8-1.2-3-2.4-3.4z" style="fill:var(--white)"/><rect x="35" y="5" width="8" height="1" style="fill:var(--pink)"/>
    <g style="fill:var(--red)"><path d="M44.4 3h2.4v5.6l2.2 1.2c.8.4.6 1.2-.2 1.2H45c-.4 0-.6-.2-.6-.6z"/><path d="M48.2 3h2.4v5.6l2.2 1.2c.8.4.6 1.2-.2 1.2h-3.8c-.4 0-.6-.2-.6-.6z"/></g>
    <path d="M44.4 4.6h2.4M44.4 6.2h2.4M48.2 4.6h2.4M48.2 6.2h2.4" style="stroke:var(--white);stroke-width:.5"/>
    <rect x="0" y="11" width="54" height="2.4" rx=".6" style="fill:var(--wood-dark)"/><path d="M4 13.4V20M50 13.4V20" style="stroke:var(--wood-dark);stroke-width:2"/>
  </svg></div>
  <div class="piece" style="--x:8;--y:33;--w:14;--ar:14/22;--d:.12"><svg viewBox="0 0 14 22">
    {/* Back in from the rain, in a raincoat with its hood up and green wellies. */}
    <g class="hop">
      <use href="#child" x="1" y="2" width="12" height="18" style="--clothes:var(--yellow);--skin:var(--skin-2);--hair:var(--hair-1)"/>
      <path d="M3.6 7.4a3.6 3.6 0 1 1 6.8 0" style="fill:none;stroke:var(--yellow);stroke-width:1.2"/>
      <g style="fill:var(--grass-dark)"><rect x="4.2" y="16.6" width="2.4" height="3.6" rx=".5"/><rect x="7.4" y="16.6" width="2.4" height="3.6" rx=".5"/></g>
    </g>
    <g style="fill:var(--sea-light)"><path d="M1.6 13.4q.7 1.1 0 1.8-.7-.7 0-1.8z"/><path d="M12.4 15.4q.7 1.1 0 1.8-.7-.7 0-1.8z"/><path d="M2.4 18.4q.6 1 0 1.6-.6-.6 0-1.6z"/></g>
  </svg></div>
  <div class="piece" style="--x:30;--y:31;--w:14;--ar:14/16;--d:.22"><svg viewBox="0 0 14 16">
    {/* An open bag, with a sock and a T-shirt sleeve peeping out. */}
    <path d="M4 5.4c-.4-2 .2-3.4 1.4-3.4h1.8v4z" style="fill:var(--red)"/><path d="M7.4 6V2.6c0-1 3-1.2 3.6.4l.2 3z" style="fill:var(--classe)"/>
    <path d="M1 5h12l-.8 10a1 1 0 0 1-1 1H2.8a1 1 0 0 1-1-1z" style="fill:var(--escola)"/>
    <path d="M1 5c2 1.4 10 1.4 12 0" style="fill:none;stroke:var(--white);stroke-width:.5"/>
    <rect x="5.2" y="9" width="3.6" height="2.4" rx=".3" style="fill:var(--white)"/>
  </svg></div>
  <div class="piece" style="--x:66;--y:35;--w:14;--ar:14/10;--d:.3"><svg viewBox="0 0 14 10">
    <g style="fill:var(--red)"><path d="M.4 0h3.2v6.4h2c.8 0 1.4.6 1.4 1.4V10H.4z"/><path d="M7 0h3.2v6.4h2c.8 0 1.4.6 1.4 1.4V10H7z"/></g>
    <path d="M.4 1.4h3.2M7 1.4h3.2" style="stroke:var(--white);stroke-width:.5;opacity:.6"/>
  </svg></div>
  <div class="piece" style="--x:80;--y:27;--w:14;--ar:14/12;--d:.38"><svg viewBox="0 0 14 12">
    {/* An umbrella left open to dry. */}
    <path d="M1 7a6 6 0 0 1 12 0c-1-1-2-1-3 0-1-1-2-1-3 0-1-1-2-1-3 0-1-1-2-1-3 0z" style="fill:var(--escola)"/>
    <path d="M4 7c0-3 1.4-5.4 3-6M10 7c0-3-1.4-5.4-3-6" style="fill:none;stroke:var(--white);stroke-width:.45;opacity:.7"/>
    <path d="M7 1V11" style="stroke:var(--black);stroke-width:.6"/><path d="M7 11a1.2 1.2 0 0 0 2.4 0" style="fill:none;stroke:var(--black);stroke-width:.6;stroke-linecap:round"/>
  </svg></div>
</div>
