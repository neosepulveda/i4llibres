---
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
// The castanyera's stall under the autumn trees, for the Castanyada at the end of October: chestnuts
// roasting, a child with a paper cone, a basket of chestnuts and sweet potatoes, and panellets.
const sign = { ca:'Castanyes', es:'Castañas', en:'Chestnuts' }[Astro.props.language];
// Leaves in the air, on the ground and in the grass at the front: left, top, size, turn and colour.
type Leaf = readonly [number, number, number, number, string];
const falling: Leaf[] = [[30, 9, 3, 35, 'orange'], [42, 4, 2.6, -40, 'red'], [58, 8, 2.8, 70, 'classe'], [18, 20, 2.6, -20, 'classe'], [74, 5, 2.4, 20, 'orange']];
const fallen: Leaf[] = [[12, 14, 3, 20, 'orange'], [22, 30, 3, -50, 'red'], [70, 10, 3, 80, 'classe'], [84, 26, 3.4, 10, 'orange'], [52, 22, 3, 120, 'red'], [6, 34, 3, 60, 'classe'], [92, 35, 3, -30, 'red']];
const front: Leaf[] = [[4, 1, 3, 70, 'orange'], [9, 1.4, 2.6, -60, 'red'], [30, 1.2, 2.8, 100, 'classe'], [64, 1, 3, 60, 'red'], [84, 1.2, 2.8, -80, 'orange'], [90, 1.4, 2.6, 40, 'classe']];
// The awning's stripes, red and white, each with a scalloped edge.
const stripes = Array.from({ length:8 }, (_, i) => ({ x:1 + 6 * i, colour:i % 2 ? 'white' : 'red' }));
// Chestnuts: left, top and size.
const inCone = [[10.9, 15.6, 2.4], [12.9, 15.2, 2.4]] as const;
const inPan = [[30.6, 16.9, 2.8], [33.3, 16.4, 2.8], [36, 16.8, 2.8], [38.6, 16.5, 2.8]] as const;
const inBasket = [[2.4, 1.4, 3.4], [5.6, .8, 3.4], [8.6, 1.6, 3.4]] as const;
const panellets = [[5, 4.8], [8.6, 4.6], [12.2, 4.8], [6.8, 2.6], [10.4, 2.6]] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="84" cy="11" r="5" style="fill:var(--sun)"/><g class="night"><circle cx="84" cy="11" r="5" style="fill:var(--sun)"/><circle cx="86.4" cy="9.6" r="4.4" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="8" y="7" width="18" height="7"/><use href="#cloud" x="50" y="13" width="13" height="5"/></g>
  <path d="M0 50V37c12-6 24-7 38-3s26-8 42-5 20 5 20 5v16z" style="fill:var(--grass-light)"/>
  <use href="#autumn-tree" x="3" y="25" width="9" height="15"/><use href="#autumn-tree" x="66" y="22" width="10" height="17"/><use href="#autumn-tree" x="89" y="27" width="8" height="13"/>
  {falling.map(([x, y, size, turn, colour]) => <use href="#leaf" x={x} y={y} width={size} height={size} transform={`rotate(${turn} ${x + size / 2} ${y + size / 2})`} style={`fill:var(--${colour})`}/>)}
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><rect width="100" height="40" style="fill:var(--sand)"/><path d="M36 0h28l10 40H26z" style="fill:var(--sand-dark);opacity:.45"/>
  {fallen.map(([x, y, size, turn, colour]) => <use href="#leaf" x={x} y={y} width={size} height={size} transform={`rotate(${turn} ${x + size / 2} ${y + size / 2})`} style={`fill:var(--${colour})`}/>)}</svg>
  <div class="piece" style="--x:-2;--y:4;--w:104;--ar:104/16;--d:0"><svg viewBox="0 0 104 16"><use href="#autumn-tree" x="8" y="0" width="8" height="13.4"/><use href="#autumn-tree" x="86" y="-1" width="9" height="15"/><path d="M0 16v-4c10-5 22-5 32-1s22-5 36-3 24 5 36 1v7z" style="fill:var(--grass)"/></svg></div>
  <div class="piece" style="--x:25;--y:11;--w:50;--ar:50/40;--d:.12"><svg viewBox="0 0 50 40">
    <g style="fill:var(--wood-dark)"><rect x="4" y="3" width="1.4" height="37"/><rect x="44.6" y="3" width="1.4" height="37"/></g>
    {/* The castanyera, in a shawl and a spotted headscarf, holds out a paper cone. */}
    <path d="M16.6 27c0-5.6 3-8.4 6.8-8.4s6.8 2.8 6.8 8.4z" style="fill:var(--cloth)"/><path d="M19.4 20.2l4 4.6 4-4.6" style="fill:none;stroke:var(--white);stroke-width:.45;opacity:.55"/>
    <circle cx="23.4" cy="15.6" r="3.3" style="fill:var(--skin-4)"/>
    <path d="M19.8 16.6C19.3 12.2 21.2 10.6 23.4 10.6s4.1 1.6 3.6 6c-.8-2.2-2-3.2-3.6-3.2s-2.8 1-3.6 3.2z" style="fill:var(--red)"/><path d="M22.2 18.7h2.4l-1.2 1.9z" style="fill:var(--red)"/>
    <g style="fill:var(--white)"><circle cx="21.8" cy="12.4" r=".35"/><circle cx="24.6" cy="11.9" r=".35"/><circle cx="26.2" cy="14" r=".35"/><circle cx="20.6" cy="14.6" r=".35"/></g>
    <g style="fill:var(--black)"><circle cx="22.3" cy="15.9" r=".42"/><circle cx="24.5" cy="15.9" r=".42"/></g><path d="M22.5 17.3q.9.7 1.8 0" style="fill:none;stroke:var(--black);stroke-width:.35"/>
    <path d="M18.6 22.8 14.2 21" style="stroke:var(--cloth);stroke-width:2;stroke-linecap:round"/>
    <path d="M13.4 22.6 11.2 17.6h4.4z" style="fill:var(--wall)"/><path d="M12 19.2h2.8M12.6 20.8h1.6" style="stroke:var(--wall-dark);stroke-width:.35"/>
    <circle cx="13.6" cy="21.2" r=".95" style="fill:var(--skin-4)"/>
    {inCone.map(([x, y, size]) => <use href="#chestnut" x={x} y={y} width={size} height={size}/>)}
    {/* The brazier, its pan of chestnuts and their smoke. */}
    <rect x="30" y="20.4" width="11" height="5.8" rx=".6" style="fill:var(--black)"/><g style="fill:var(--orange)"><circle cx="32.4" cy="23.8" r=".6"/><circle cx="35.5" cy="24.4" r=".6"/><circle cx="38.6" cy="23.6" r=".6"/></g>
    <path d="M42.4 19.8 48.4 18" style="stroke:var(--black);stroke-width:.7;stroke-linecap:round"/><ellipse cx="35.5" cy="19.9" rx="7" ry="1.7" style="fill:var(--steel)"/>
    {inPan.map(([x, y, size]) => <use href="#chestnut" x={x} y={y} width={size} height={size}/>)}
    <g style="fill:none;stroke:var(--white);stroke-width:1.2;stroke-linecap:round"><path class="smoke" d="M32 15.4c-1.6-1.8 1.6-3 0-4.8"/><path class="smoke b" d="M35.6 15c-1.6-1.8 1.6-3 0-4.8"/><path class="smoke c" d="M39.2 15.4c-1.6-1.8 1.6-3 0-4.8"/></g>
    <rect x="3" y="26" width="44" height="14" style="fill:var(--wood)"/><rect x="2.4" y="25.4" width="45.2" height="1.6" rx=".4" style="fill:var(--wood-dark)"/><g style="fill:var(--wood-dark)"><rect x="3" y="31.6" width="44" height=".6"/><rect x="3" y="36" width="44" height=".6"/></g>
    <g transform="rotate(-2 17.5 31.8)"><rect x="8" y="28.6" width="19" height="6.4" rx=".3" style="fill:var(--white)"/><text x="17.5" y="33" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:3.1px;fill:var(--menjador)">{sign}</text></g>
    <rect x="1" y="1" width="48" height="1.4" rx=".5" style="fill:var(--wood-dark)"/>
    {stripes.map(({ x, colour }) => <><rect x={x} y="2.2" width="6" height="5" style={`fill:var(--${colour})`}/><path d={`M${x} 7.1a3 3 0 0 0 6 0z`} style={`fill:var(--${colour})`}/></>)}
  </svg></div>
  <div class="piece" style="--x:73;--y:24;--w:16;--ar:16/22;--d:.24"><svg viewBox="0 0 16 22">
    <use href="#child" x="1" y="4" width="12" height="18" style="--clothes:var(--escola);--skin:var(--skin-3);--hair:var(--hair-3)"/>
    <path d="M3.2 11.6 1.6 15M10.8 11.4l2.6-3.2" style="stroke:var(--skin-3);stroke-width:1.2;stroke-linecap:round"/>
    <path d="M13.6 9.6 11.6 4.4h4z" style="fill:var(--wall)"/><path d="M12.3 5.8h2.6M12.8 7.2h1.6" style="stroke:var(--wall-dark);stroke-width:.35"/>
    <use href="#chestnut" x="11.4" y="2.4" width="2.2" height="2.2"/><use href="#chestnut" x="13.3" y="2.6" width="2.1" height="2.1"/>
  </svg></div>
  <div class="piece" style="--x:7;--y:30;--w:24;--ar:24/12;--d:.32"><svg viewBox="0 0 24 12">
    {inBasket.map(([x, y, size]) => <use href="#chestnut" x={x} y={y} width={size} height={size}/>)}
    <ellipse cx="15.4" cy="3.4" rx="3.8" ry="1.6" transform="rotate(-12 15.4 3.4)" style="fill:var(--menjador)"/><ellipse cx="19.4" cy="3.8" rx="3" ry="1.4" transform="rotate(14 19.4 3.8)" style="fill:var(--menjador);filter:brightness(.85)"/>
    <path d="M1.4 4.6h21.2l-2.4 7.4H3.8z" style="fill:var(--wood)"/><path d="M2.4 7.2h19.2M3.2 9.6h17.6" style="stroke:var(--wood-dark);stroke-width:.5"/><path d="M7 4.6v7.4M12 4.6v7.4M17 4.6v7.4" style="stroke:var(--wood-dark);stroke-width:.4;opacity:.6"/><rect x="1" y="4" width="22" height="1.4" rx=".7" style="fill:var(--wood-dark)"/>
  </svg></div>
  <div class="piece" style="--x:41;--y:33;--w:18;--ar:18/8;--d:.38"><svg viewBox="0 0 18 8">
    <ellipse cx="9" cy="6.4" rx="8.6" ry="1.6" style="fill:var(--white)"/><ellipse cx="9" cy="6.1" rx="6.4" ry="1" style="fill:var(--wall-dark)"/>
    {panellets.map(([x, y]) => <><circle cx={x} cy={y} r="1.7" style="fill:var(--sand-dark)"/><g style="fill:var(--cream)"><ellipse cx={x - .6} cy={y - .5} rx=".4" ry=".2" transform={`rotate(-30 ${x - .6} ${y - .5})`}/><ellipse cx={x + .5} cy={y - .7} rx=".4" ry=".2" transform={`rotate(20 ${x + .5} ${y - .7})`}/><ellipse cx={x + .2} cy={y + .4} rx=".4" ry=".2" transform={`rotate(70 ${x + .2} ${y + .4})`}/></g></>)}
  </svg></div>
  <div class="piece" style="--x:-1;--y:37;--w:102;--ar:102/4;--d:.44"><svg viewBox="0 0 102 4">
    {front.map(([x, y, size, turn, colour]) => <use href="#leaf" x={x} y={y} width={size} height={size} transform={`rotate(${turn} ${x + size / 2} ${y + size / 2})`} style={`fill:var(--${colour})`}/>)}
  </svg></div>
</div>
