---
// The Punt Verd Mòbil, the city's mobile recycling point, parked in the playground in front of
// the school: a lorry with its side open on bays of batteries, light bulbs, paint tins and
// clothes. A child brings a bag of old clothes; on the ground wait a box of books with a desk
// lamp, a jar of used batteries with a light bulb, and a pair of worn shoes.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
// The school's windows behind the playground.
const windows = [6, 22, 38, 54, 70, 86] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="86" cy="7" r="3.6" style="fill:var(--sun)"/><g class="night"><circle cx="86" cy="7" r="3.6" style="fill:var(--sun)"/><circle cx="87.8" cy="6" r="3.2" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="8" y="3" width="16" height="6.4"/><use href="#cloud" x="56" y="6" width="12" height="4.8"/></g>
  <rect y="14" width="100" height="36" style="fill:var(--wall)"/><rect y="13" width="100" height="1.6" style="fill:var(--wall-dark)"/>
  {windows.map(x => <g><rect x={x - .6} y="18.4" width="9.2" height="9.2" rx=".4" style="fill:var(--wood-dark)"/><rect x={x} y="19" width="8" height="8" style="fill:var(--window)"/><path d={`M${x + 4} 19v8M${x} 23h8`} style="stroke:var(--wood-dark);stroke-width:.5"/></g>)}
  <rect y="34" width="100" height="16" style="fill:var(--wall-dark);opacity:.35"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--sand)"/>
  <path d="M30 0h40l6 40H24z" style="fill:var(--sand-dark);opacity:.45"/>
  <g style="fill:none;stroke:var(--white);stroke-width:.5;opacity:.8"><path d="M6 24h8v8H6zM6 32h8v8H6zM14 28h8v8h-8z"/></g>
</svg>
  <div class="piece" style="--x:20;--y:16;--w:60;--ar:60/28;--d:0"><svg viewBox="0 0 60 28">
    {/* The lorry, its side open on the bays. */}
    <rect x="0" y="2" width="42" height="20" rx="1.2" style="fill:var(--white)"/>
    <rect x="0" y="2" width="42" height="4.6" rx="1.2" style="fill:var(--escola)"/>
    <text x="21" y="5.6" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:3.4px;fill:var(--white)">Punt Verd</text>
    <g style="fill:var(--steel)"><rect x="2" y="8" width="9" height="12"/><rect x="12" y="8" width="9" height="12"/><rect x="22" y="8" width="9" height="12"/><rect x="32" y="8" width="8" height="12"/></g>
    <g style="fill:var(--black);opacity:.25"><rect x="2" y="8" width="9" height="1"/><rect x="12" y="8" width="9" height="1"/><rect x="22" y="8" width="9" height="1"/><rect x="32" y="8" width="8" height="1"/></g>
    {/* Batteries, light bulbs, paint tins and folded clothes. */}
    <g style="fill:var(--yellow)"><rect x="3.4" y="15" width="1.8" height="4.6" rx=".3"/><rect x="5.8" y="14.4" width="1.8" height="5.2" rx=".3"/><rect x="8.2" y="15.4" width="1.8" height="4.2" rx=".3"/></g>
    <g style="fill:var(--black)"><rect x="3.4" y="15" width="1.8" height="1.2"/><rect x="5.8" y="14.4" width="1.8" height="1.2"/><rect x="8.2" y="15.4" width="1.8" height="1.2"/></g>
    <g style="fill:var(--sun)"><circle cx="14.6" cy="15.6" r="1.7"/><circle cx="18.4" cy="16.4" r="1.7"/></g><g style="fill:var(--steel)"><rect x="14" y="17.2" width="1.2" height="1.6"/><rect x="17.8" y="18" width="1.2" height="1.6"/></g>
    <rect x="23.4" y="14.6" width="3.4" height="5" rx=".3" style="fill:var(--red)"/><rect x="27.2" y="15.6" width="3" height="4" rx=".3" style="fill:var(--sea)"/><path d="M23.4 15.4h3.4M27.2 16.4h3" style="stroke:var(--white);stroke-width:.4;opacity:.7"/>
    <rect x="33" y="17.6" width="6" height="2" rx=".3" style="fill:var(--classe)"/><rect x="33.4" y="15.6" width="5.4" height="2" rx=".3" style="fill:var(--pink)"/><rect x="33.8" y="13.6" width="4.6" height="2" rx=".3" style="fill:var(--lilac)"/>
    <path d="M42 8h9.4l5.6 6.8V22H42z" style="fill:var(--escola)"/><path d="M44 9.6h6.4l3.8 5H44z" style="fill:var(--sky-light)"/>
    <rect x="0" y="20.6" width="58" height="2" rx=".6" style="fill:var(--black);opacity:.8"/>
    <g style="fill:var(--black)"><circle cx="9" cy="23.4" r="3.4"/><circle cx="31" cy="23.4" r="3.4"/><circle cx="49" cy="23.4" r="3.4"/></g>
    <g style="fill:var(--steel)"><circle cx="9" cy="23.4" r="1.2"/><circle cx="31" cy="23.4" r="1.2"/><circle cx="49" cy="23.4" r="1.2"/></g>
  </svg></div>
  <div class="piece" style="--x:12;--y:31;--w:15;--ar:16/22;--d:.14"><svg viewBox="0 0 16 22">
    {/* A child carrying a bag of old clothes, a sleeve hanging out. */}
    <g class="hop">
      <use href="#child" x="1" y="3" width="12" height="18" style="--clothes:var(--menjador);--skin:var(--skin-4);--hair:var(--hair-1)"/>
      <path d="M9 10.6c1.6-.4 2.6.4 3 1.6" style="fill:none;stroke:var(--classe);stroke-width:1.4;stroke-linecap:round"/>
      <path d="M8.4 11.2h7l-.6 6.8a1 1 0 0 1-1 1h-3.8a1 1 0 0 1-1-1z" style="fill:var(--escola)"/>
      <path d="M13.8 18.4c.6 1 .6 2 .2 2.8" style="fill:none;stroke:var(--classe);stroke-width:1.2;stroke-linecap:round"/>
      <path d="M4.6 12.4 9 13.6" style="stroke:var(--skin-4);stroke-width:1.2;stroke-linecap:round"/>
    </g>
  </svg></div>
  <div class="piece" style="--x:58;--y:30;--w:16;--ar:16/14;--d:.24"><svg viewBox="0 0 16 14">
    {/* A box of old books, with a desk lamp leaning on it. */}
    <g style="fill:var(--black);opacity:.15"><rect x="1" y="5" width="10" height="9"/></g>
    <rect x="2.2" y="4.6" width="1.6" height="3.6" style="fill:var(--red)"/><rect x="4" y="3.8" width="1.6" height="4.4" style="fill:var(--sea)"/><rect x="5.8" y="4.4" width="1.4" height="3.8" style="fill:var(--classe)"/><rect x="7.4" y="3.6" width="1.8" height="4.6" style="fill:var(--grass-dark)"/>
    <rect x="1" y="7" width="10" height="7" style="fill:var(--cardboard)"/><path d="M1 7l-1 1.6M11 7l1 1.6" style="stroke:var(--cardboard);stroke-width:.8"/>
    <rect x="12.4" y="12.6" width="3.4" height="1.4" rx=".3" style="fill:var(--black)"/>
    <path d="M14 12.6 12.6 7.6l2.6-3" style="fill:none;stroke:var(--black);stroke-width:.5;stroke-linecap:round"/>
    <path d="M13.4 2.6l3 .4-1.6 3.4z" style="fill:var(--yellow)"/>
  </svg></div>
  <div class="piece" style="--x:73;--y:33;--w:11;--ar:12/12;--d:.32"><svg viewBox="0 0 12 12">
    {/* A jar of used batteries, and a light bulb beside it. */}
    <rect x="1" y="3.6" width="6.4" height="8.4" rx="1" style="fill:var(--sky-light);opacity:.7"/><rect x="1.4" y="2.6" width="5.6" height="1.4" rx=".3" style="fill:var(--escola)"/>
    <g style="fill:var(--yellow)"><rect x="1.8" y="8" width="1.4" height="3.6" rx=".2"/><rect x="3.6" y="7.4" width="1.4" height="4.2" rx=".2"/><rect x="5.2" y="8.4" width="1.4" height="3.2" rx=".2" style="fill:var(--orange)"/></g>
    <circle cx="9.6" cy="8.2" r="1.8" style="fill:var(--sun)"/><rect x="9" y="9.8" width="1.2" height="1.6" style="fill:var(--steel)"/><rect x="8.6" y="11.4" width="2" height=".6" style="fill:var(--black)"/>
  </svg></div>
  <div class="piece" style="--x:34;--y:33;--w:12;--ar:12/6;--d:.4"><svg viewBox="0 0 12 6">
    {/* A pair of worn shoes. */}
    <g style="fill:var(--wood-dark)"><path d="M.4 2.4h2.8v1.4l2.2.8c.6.2.6 1.2 0 1.2H.4z"/><path d="M6.4 2h2.8v1.4l2.2.8c.6.2.6 1.2 0 1.2H6.4z"/></g>
    <path d="M1 3.2h1.8M7 2.8h1.8" style="stroke:var(--white);stroke-width:.35;opacity:.6"/>
  </svg></div>
</div>
