---
// An autumn exhibition: a chestnut hedgehog, a pumpkin owl and a collage of leaves.
const spines = [[5,8,1,2],[7,6,5,0],[10,5,10,-1],[13,6,16,0],[15,8,20,3]];
const leaves: [number, number, number, number, string][] = [[4,3,8,-25,'orange'],[12,2,7,25,'red'],[8,9,8,70,'classe']];
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="84" cy="11" r="5" style="fill:var(--sun)"/>
  <g class="night"><circle cx="84" cy="11" r="5" style="fill:var(--sun)"/><circle cx="86.4" cy="9.6" r="4.4" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="14" y="9" width="18" height="7"/></g>
  <path d="M0 50V37q22-8 48-2t52-5v20z" style="fill:var(--grass-light)"/>
  <use href="#autumn-tree" x="4" y="20" width="12" height="20"/>
  <use href="#autumn-tree" x="86" y="24" width="10" height="17"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--sand)"/>
  <use href="#leaf" x="8" y="30" width="4" height="4" style="fill:var(--orange)"/>
  <use href="#leaf" x="88" y="23" width="3" height="3" style="fill:var(--red)"/>
</svg>
  <div class="piece" style="--x:12;--y:29;--w:76;--ar:76/16;--d:0"><svg viewBox="0 0 76 16">
    <g style="fill:var(--wood-dark)"><path d="M6 2h3l-1 14H5zM67 2h3l1 14h-3z"/><rect x="7" y="10" width="62" height="1.2"/></g>
    <rect width="76" height="2.6" rx=".5" style="fill:var(--wood)"/>
    <path d="M0 2.6h76" style="stroke:var(--wood-dark);stroke-width:.6"/>
  </svg></div>
  <div class="piece autumn-hedgehog" style="--x:19;--y:13;--w:23;--ar:23/18;--d:.12"><svg viewBox="0 -2 23 18">
    <path d="M1 15h21" style="stroke:var(--wall-dark);stroke-width:1.4;stroke-linecap:round"/>
    <g style="stroke:var(--wood-dark);stroke-width:.7;stroke-linecap:round">{spines.map(([x,y,toX,toY])=><path d={`M${x} ${y} ${toX} ${toY}`}/>)}</g>
    <ellipse cx="10" cy="10" rx="8" ry="5" style="fill:var(--wood-dark)"/>
    <path d="M4 11c2 4 10 4 12 0" style="fill:var(--cardboard)"/>
    <path d="M16 8q3 0 5 3l-4 2z" style="fill:var(--sand-dark)"/>
    <circle cx="20.8" cy="11" r=".7" style="fill:var(--black)"/>
    <circle cx="17.5" cy="9.5" r=".4" style="fill:var(--black)"/>
  </svg></div>
  <div class="piece autumn-owl" style="--x:43;--y:13;--w:21;--ar:21/25;--d:.24"><svg viewBox="0 0 21 25">
    <path d="M3 24h15" style="stroke:var(--wall-dark);stroke-width:1.4;stroke-linecap:round"/>
    <path d="M10 5q-1-3 1-4" style="fill:none;stroke:var(--wood-dark);stroke-width:1.3;stroke-linecap:round"/>
    <ellipse cx="10.5" cy="14" rx="8.2" ry="9" style="fill:var(--orange)"/>
    <ellipse cx="10.5" cy="14" rx="4.6" ry="9" style="fill:none;stroke:var(--red);stroke-width:.5;opacity:.6"/>
    <use href="#leaf" x="0" y="12" width="6" height="10" style="fill:var(--menjador)"/>
    <use href="#leaf" x="15" y="12" width="6" height="10" style="fill:var(--menjador)"/>
    <circle cx="7" cy="11" r="3" style="fill:var(--cream)"/><circle cx="14" cy="11" r="3" style="fill:var(--cream)"/>
    <g style="fill:var(--wood-dark)"><circle cx="7" cy="11" r="1.2"/><circle cx="14" cy="11" r="1.2"/><path d="m9 14 1.5 3 1.5-3z"/></g>
  </svg></div>
  <div class="piece autumn-collage" style="--x:65;--y:13;--w:19;--ar:19/25;--d:.36"><svg viewBox="0 0 22 29">
    <path d="M2 29 11 3l9 26M11 3v26" style="fill:none;stroke:var(--wood-dark);stroke-width:1"/>
    <rect x="1" y="1" width="20" height="24" rx=".4" style="fill:var(--white);stroke:var(--cardboard);stroke-width:.7"/>
    <path d="M10 21 10 8M10 16 5 9M10 13l6-7" style="fill:none;stroke:var(--wood-dark);stroke-width:.6"/>
    {leaves.map(([x,y,size,turn,colour])=><use href="#leaf" x={x} y={y} width={size} height={size} transform={`rotate(${turn} ${x+size/2} ${y+size/2})`} style={`fill:var(--${colour})`}/>)}
    <rect x="0" y="25" width="22" height="1.2" rx=".3" style="fill:var(--wood-dark)"/>
  </svg></div>
</div>
