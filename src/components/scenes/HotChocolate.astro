---
// The AFA's charity hot chocolate for La Marató, under the sports hall porch on a December
// afternoon: lights strung along the porch, a stall with a steaming pot, paper cups, a plate of
// melindros and a jar with a heart for donations, a volunteer ladling, and a child in a woolly hat
// with a cup. Beside it Oncle Buscall arrives waving, in his ivy coat, long beard and pointed hat,
// with the Tió in its barretina and blanket. The stall's sign is translated; nothing else has words.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const sign = { ca:'Xocolata', es:'Chocolate', en:'Hot chocolate' }[Astro.props.language];
// The lights hang in four loops from the porch roof; each bulb sits on its loop.
const loops = [0, 25, 50, 75] as const;
const colours = ['yellow', 'red', 'escola', 'orange'] as const;
const bulbs = loops.flatMap(x0 => [.2, .4, .6, .8].map(t => ({ x:x0 + 25 * t, y:13.4 + 7.2 * (1 - t) * t }))).map((bulb, i) => ({ ...bulb, colour:colours[i % 4], glow:i % 2 === 0 }));
// The hall's high windows.
const windows = [9, 21, 33, 45, 57, 69, 81] as const;
// Ivy leaves on Oncle Buscall's coat, sleeves and staff: left, top, size, turn and colour.
const ivy = 'M0 1.1C-.5.7-1.3.6-1.2-.1-1.1-.5-.6-.4-.5-.6-.5-1-.2-1.2 0-1.3.2-1.2.5-1 .5-.6.6-.4 1.1-.5 1.2-.1 1.3.6.5.7 0 1.1z';
type Leaf = readonly [number, number, number, number, string];
const leaves: Leaf[] = [
  [4.6, 18, .9, 20, 'grass'], [11.8, 17, .9, 40, 'grass'], [4.2, 22, 1, -10, 'grass-light'], [12.6, 21.6, .9, 10, 'grass'],
  [6.6, 22.4, .8, 60, 'grass'], [10, 23, .9, -40, 'grass-light'], [3.8, 26, 1, 30, 'grass'], [6.4, 25.6, .9, -60, 'grass-light'],
  [9, 26.6, 1, 20, 'grass'], [12, 25.8, .9, -20, 'grass-light'], [13.6, 29.6, .9, 50, 'grass'], [4, 30, .9, -30, 'grass-light'],
  [7, 29.6, 1, 10, 'grass'], [10.4, 30, .9, 70, 'grass-light'], [4.2, 13.8, .8, 30, 'grass'], [13.8, 17.6, .8, -20, 'grass-light'],
  [15, 6.2, .9, -30, 'grass'], [16.4, 7.4, .8, 40, 'grass-light'],
];
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="86" cy="5" r="2.6" style="fill:var(--sun)"/><g class="night"><circle cx="86" cy="5" r="2.6" style="fill:var(--sun)"/><circle cx="87.2" cy="4.3" r="2.3" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="8" y="1.4" width="13" height="5.2"/><use href="#cloud" x="52" y="2.2" width="10" height="4"/></g>
  {/* The sports hall, its high windows and green doors, under the porch roof and its pillars. */}
  <rect y="12" width="100" height="38" style="fill:var(--tile)"/>
  {windows.map(x => <g><rect x={x - .6} y="16.4" width="9.2" height="5.2" rx=".3" style="fill:var(--wall)"/><rect x={x} y="17" width="8" height="4" style="fill:var(--window)"/><path d={`M${x + 4} 17v4`} style="stroke:var(--wall);stroke-width:.5"/></g>)}
  <rect x="40" y="27" width="20" height="23" style="fill:var(--escola)"/><path d="M50 27v23" style="stroke:var(--wall);stroke-width:.5;opacity:.7"/>
  <rect y="44" width="100" height="6" style="fill:var(--wall-dark);opacity:.4"/>
  <rect y="8.4" width="100" height="4" style="fill:var(--wall-dark)"/><rect y="12" width="100" height="1" style="fill:var(--escola)"/>
  <g style="fill:var(--wall-dark)"><rect x="2" y="13" width="2.6" height="37"/><rect x="95.4" y="13" width="2.6" height="37"/></g>
  {/* The lights, glowing at dusk. */}
  <path d={`M0 13.4${loops.map(x0 => `Q${x0 + 12.5} 17 ${x0 + 25} 13.4`).join('')}`} style="fill:none;stroke:var(--black);stroke-width:.3"/>
  <g class="night" style="fill:var(--yellow);opacity:.35">{bulbs.map(({ x, y }) => <circle cx={x} cy={y + .8} r="1.6"/>)}</g>
  {bulbs.map(({ x, y, colour, glow }) => <g class={glow ? 'glow' : undefined}><rect x={x - .3} y={y - .2} width=".6" height=".6" style="fill:var(--black)"/><circle cx={x} cy={y + .9} r=".7" style={`fill:var(--${colour})`}/></g>)}
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--wall-dark)"/>
  <path d="M0 8h100M0 17h100M0 26h100M12.5 0v32M37.5 0v32M62.5 0v32M87.5 0v32" style="stroke:var(--wall);stroke-width:.4;opacity:.7"/>
  <rect y="32" width="100" height="8" style="fill:var(--sand)"/><rect y="31.6" width="100" height="1" style="fill:var(--wall)"/>
</svg>
  <div class="piece" style="--x:25;--y:14;--w:50;--ar:50/34;--d:0"><svg viewBox="0 0 50 34">
    {/* A volunteer in a scarf ladles out the chocolate. */}
    <path d="M13 10.6c-3 0-4.4 2.4-4.6 6.6l-.2 4.4h9.6l-.2-4.4c-.2-4.2-1.6-6.6-4.6-6.6z" style="fill:var(--afa)"/>
    <path d="M10.8 14.4h4.4v7.2h-4.4z" style="fill:var(--white)"/><path d="M11.2 14.4 12 11.4M14.8 14.4 14 11.4" style="stroke:var(--white);stroke-width:.4"/>
    <path d="M10.4 12.6 9.2 17.4" style="stroke:var(--skin-2);stroke-width:1.2;stroke-linecap:round"/>
    <path d="M15.4 12.2 18.4 10.2" style="stroke:var(--skin-2);stroke-width:1.2;stroke-linecap:round"/>
    <circle cx="13" cy="7.4" r="2.8" style="fill:var(--skin-2)"/>
    <path d="M10.2 7.6c-.4-2.6 1-4.2 2.8-4.2s3.2 1.6 2.8 4.2c-.4-1.2-1.6-2-2.8-2s-2.4.8-2.8 2z" style="fill:var(--hair-1)"/><circle cx="13" cy="3.6" r="1.2" style="fill:var(--hair-1)"/>
    <path d="M10.6 10.6h4.8" style="stroke:var(--red);stroke-width:1.3;stroke-linecap:round"/><path d="M14.4 10.8l.6 3.4" style="stroke:var(--red);stroke-width:1;stroke-linecap:round"/>
    {/* The pot on its burner, the ladle and the steam. */}
    <path d="M18.8 10l4.6 3.4" style="stroke:var(--steel);stroke-width:.6;stroke-linecap:round"/><circle cx="18.6" cy="10" r=".9" style="fill:var(--skin-2)"/>
    <rect x="18.6" y="19.4" width="10.8" height="1.8" rx=".3" style="fill:var(--black)"/>
    <path d="M17.2 14.6h1.4M29.4 14.6h1.4" style="stroke:var(--steel);stroke-width:.9;stroke-linecap:round"/>
    <path d="M18.4 13.6h11.2v5a1 1 0 0 1-1 1h-9.2a1 1 0 0 1-1-1z" style="fill:var(--steel)"/><path d="M20 15v3.2" style="stroke:var(--white);stroke-width:.5;opacity:.6"/>
    <ellipse cx="24" cy="13.6" rx="5.6" ry="1.1" style="fill:var(--steel)"/><ellipse cx="24" cy="13.6" rx="4.8" ry=".7" style="fill:var(--hair-2)"/>
    <g style="fill:none;stroke:var(--white);stroke-width:1.2;stroke-linecap:round"><path class="smoke" d="M22 11c-1.6-1.8 1.6-3 0-4.8"/><path class="smoke b" d="M25.4 10.6c-1.6-1.8 1.6-3 0-4.8"/><path class="smoke c" d="M28 11c-1.6-1.8 1.6-3 0-4.8"/></g>
    {/* A stack of paper cups, two poured, and a plate of melindros. */}
    <path d="M31 15.4h3.2l-.6 5.6h-2z" style="fill:var(--white)"/><path d="M31.2 16.6h2.8M31.4 17.8h2.4" style="stroke:var(--wall-dark);stroke-width:.3"/>
    {[35.2, 38.4].map(x => <><path d={`M${x} 17.8h2.8l-.4 3.2h-2z`} style="fill:var(--white)"/><rect x={x + .2} y="19.2" width="2.4" height=".6" style="fill:var(--afa)"/><ellipse cx={x + 1.4} cy="17.8" rx="1.4" ry=".35" style="fill:var(--hair-2)"/></>)}
    <ellipse cx="45" cy="20.6" rx="4" ry=".9" style="fill:var(--white)"/>
    <g style="fill:var(--envelope)"><rect x="42" y="18.8" width="4.6" height="1.3" rx=".65" transform="rotate(-8 44.3 19.5)"/><rect x="43.4" y="17.6" width="4.6" height="1.3" rx=".65" transform="rotate(10 45.7 18.3)"/><rect x="42.6" y="16.6" width="4.6" height="1.3" rx=".65" transform="rotate(-4 44.9 17.3)"/></g>
    <g style="fill:var(--white)"><circle cx="43.4" cy="19.2" r=".2"/><circle cx="45.2" cy="18.9" r=".2"/><circle cx="46.4" cy="18.4" r=".2"/><circle cx="44" cy="17" r=".2"/><circle cx="45.8" cy="17.1" r=".2"/></g>
    {/* The donation jar, with a heart on it. */}
    <rect x="2.6" y="15" width="5.4" height="6" rx=".9" style="fill:var(--sky-light);opacity:.9"/>
    <g style="fill:var(--yellow)"><circle cx="3.9" cy="20.2" r=".6"/><circle cx="5.2" cy="20.4" r=".6"/><circle cx="6.6" cy="20.1" r=".6"/><circle cx="4.6" cy="19.3" r=".6"/></g>
    <rect x="2.9" y="14.2" width="4.8" height="1.2" rx=".3" style="fill:var(--afa)"/><rect x="4.3" y="14.6" width="2" height=".35" style="fill:var(--black)"/>
    <path d="M5.3 19.2c-1.6-1-2.2-1.9-1.7-2.6.4-.5 1.2-.4 1.7.2.5-.6 1.3-.7 1.7-.2.5.7-.1 1.6-1.7 2.6z" style="fill:var(--red)"/>
    {/* The trestle table, its cloth and the sign. */}
    <rect x="1" y="21" width="48" height="1.2" rx=".4" style="fill:var(--wood-dark)"/>
    <path d="M1.4 21.8h47.2v6H1.4z" style="fill:var(--white)"/><rect x="1.4" y="27" width="47.2" height=".8" style="fill:var(--red)"/>
    <path d="M5 27.8l4 6.2M9 27.8l-4 6.2M41 27.8l4 6.2M45 27.8l-4 6.2" style="stroke:var(--wood-dark);stroke-width:.9;stroke-linecap:round"/>
    <g transform="rotate(-2 25 24.6)"><rect x="13" y="22.4" width="24" height="4.4" rx=".3" style="fill:var(--afa)"/><text x="25" y="25.6" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:2.8px;fill:var(--white)">{sign}</text></g>
  </svg></div>
  <div class="piece" style="--x:80;--y:15;--w:12;--ar:12/22;--d:.1"><svg viewBox="0 0 12 22">
    {/* A fir tree in a pot by the hall door, with baubles and a star. */}
    <rect x="5.5" y="15.4" width="1" height="2" style="fill:var(--wood-dark)"/>
    <path d="M6 2 9.6 7.6H7.8L10.6 12H8.6L11.4 16H.6L3.4 12H1.4L4.2 7.6H2.4z" style="fill:var(--grass-dark)"/>
    <path d="M3.2 9.6q2.8 1.4 5.6-.6M2.2 13.6q3.8 1.6 7.6-.6" style="fill:none;stroke:var(--yellow);stroke-width:.35"/>
    <g style="fill:var(--red)"><circle cx="4.4" cy="10.4" r=".7"/><circle cx="7.8" cy="14" r=".7"/></g><g style="fill:var(--yellow)"><circle cx="7.2" cy="8.8" r=".6"/><circle cx="3.6" cy="14.4" r=".7"/></g><circle cx="5.6" cy="6" r=".55" style="fill:var(--sea-light)"/>
    <path d="M6 .2l.5 1.1 1.2.1-.9.8.3 1.2-1.1-.6-1.1.6.3-1.2-.9-.8 1.2-.1z" style="fill:var(--sun)"/>
    <path d="M3.4 17.6h5.2l-.6 4.4H4z" style="fill:var(--wood)"/><rect x="3" y="17" width="6" height="1.2" rx=".3" style="fill:var(--wood-dark)"/>
  </svg></div>
  <div class="piece" style="--x:65;--y:29;--w:13;--ar:13/20;--d:.18"><svg viewBox="0 0 13 20">
    {/* A child in a woolly hat with a cup of chocolate and a melindro. */}
    <g class="hop">
      <use href="#child" x="0" y="2" width="12" height="18" style="--clothes:var(--sea);--skin:var(--skin-3);--hair:var(--hair-3)"/>
      <path d="M3.1 5.4c0-2.4 1.3-3.6 2.9-3.6s2.9 1.2 2.9 3.6z" style="fill:var(--red)"/><rect x="2.9" y="4.6" width="6.2" height="1.1" rx=".5" style="fill:var(--white)"/><circle cx="6" cy="1.6" r=".8" style="fill:var(--white)"/>
      <path d="M9.2 10.4 10.4 12.2M2.8 10.4 2 13.2" style="stroke:var(--skin-3);stroke-width:1.1;stroke-linecap:round"/>
      <path d="M9.4 10.2h2.6l-.4 2.8h-1.8z" style="fill:var(--white)"/><ellipse cx="10.7" cy="10.2" rx="1.3" ry=".3" style="fill:var(--hair-2)"/>
      <path class="smoke" d="M10.7 9.2c-1-1.2 1-2 0-3.2" style="fill:none;stroke:var(--white);stroke-width:.7;stroke-linecap:round"/>
      <rect x=".4" y="12.6" width="3.2" height="1.1" rx=".55" transform="rotate(-30 2 13.2)" style="fill:var(--envelope)"/>
    </g>
  </svg></div>
  <div class="piece" style="--x:8;--y:33;--w:19;--ar:19/34;--d:.28"><svg viewBox="0 0 19 34">
    {/* Oncle Buscall arrives waving, in a coat of ivy, with his staff. */}
    <path d="M15.2 6.4 16.4 34" style="stroke:var(--wood-dark);stroke-width:.9;stroke-linecap:round"/>
    <path d="M15.6 7.6c-.8 1.4-.4 2.8.2 3.8M15.8 7.6c.8 1.2 1.2 2.4.8 3.6" style="fill:none;stroke:var(--orange);stroke-width:.4;stroke-linecap:round"/>
    <g style="fill:var(--black)"><rect x="5.2" y="31" width="2.8" height="3" rx=".6"/><rect x="9.6" y="31" width="2.8" height="3" rx=".6"/></g>
    <path d="M5 15.8 3.4 11.6M12.6 15.8 15.2 19" style="stroke:var(--grass-dark);stroke-width:2;stroke-linecap:round"/>
    <path d="M8.8 13.2c-3.4 0-5.2 3-5.6 8.6L2.6 31.4h12.4l-.6-9.6c-.4-5.6-2.2-8.6-5.6-8.6z" style="fill:var(--grass-dark)"/>
    {leaves.map(([x, y, size, turn, colour]) => <path d={ivy} transform={`translate(${x} ${y}) rotate(${turn}) scale(${size})`} style={`fill:var(--${colour})`}/>)}
    <g style="fill:var(--skin-1)"><circle cx="3.2" cy="10.9" r=".9"/><circle cx="15.5" cy="19.2" r=".9"/></g>
    <circle cx="8.8" cy="9.8" r="2.6" style="fill:var(--skin-1)"/>
    <path d="M6.2 10.2c0 4.4 1 8.6 2.6 10.4 1.6-1.8 2.6-6 2.6-10.4-.8 1-1.6 1.4-2.6 1.4s-1.8-.4-2.6-1.4z" style="fill:var(--white)"/><path d="M7.4 11.2q1.4-.8 2.8 0" style="fill:none;stroke:var(--white);stroke-width:.7;stroke-linecap:round"/>
    <path d="M5.8 8.4 8.6 1.2Q9.6-.2 11.4 1 9.8 1 9.6 2L11.8 8.4z" style="fill:var(--escola)"/><rect x="5.6" y="7.4" width="6.4" height="1.4" rx=".5" style="fill:var(--orange)"/>
  </svg></div>
  <div class="piece" style="--x:27;--y:35;--w:13;--ar:13/9;--d:.38"><svg viewBox="0 0 13 9">
    {/* The Tió on its two front legs, in its blanket and barretina, smiling. */}
    <path d="M8.6 7.2 8.2 9M10.2 7 10.4 9" style="stroke:var(--wood-dark);stroke-width:.6;stroke-linecap:round"/>
    <rect x="1" y="3.6" width="9.6" height="4.4" rx="2.2" transform="rotate(-6 6 5.8)" style="fill:var(--wood)"/>
    <path d="M2.4 6.6h4.6M3 5.2h4" style="stroke:var(--wood-dark);stroke-width:.35;opacity:.7"/>
    <path d="M2.4 4.2c1.6-.8 4-.8 5.6-.2l.4 4c-2.2.5-4.2.6-6.4.4z" style="fill:var(--menjador)"/>
    <path d="M3.8 3.8v4.6M5.8 3.6v4.8M2.4 6h6" style="stroke:var(--yellow);stroke-width:.3;opacity:.8"/>
    <ellipse cx="10.4" cy="5" rx="1.7" ry="2.1" style="fill:var(--sand);stroke:var(--wood-dark);stroke-width:.3"/>
    <g style="fill:var(--pink);opacity:.85"><circle cx="9.5" cy="5.4" r=".35"/><circle cx="11.3" cy="5.4" r=".35"/></g>
    <g style="fill:var(--black)"><circle cx="9.9" cy="4.6" r=".28"/><circle cx="10.9" cy="4.6" r=".28"/></g><path d="M9.8 5.6q.6.6 1.2 0" style="fill:none;stroke:var(--black);stroke-width:.25;stroke-linecap:round"/>
    <path d="M12 3.4C11.8 1.8 10.4.8 8.6 1 7.4 1.2 6.4 2 6 2.8 7 2.4 8 2.6 8.6 3.4z" style="fill:var(--red)"/><rect x="8.6" y="2.9" width="3.6" height=".9" rx=".4" style="fill:var(--red)"/>
  </svg></div>
</div>
