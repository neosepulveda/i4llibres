---
// A general strike day at the school gate: the school behind its railings with the gate open and
// the school's notice taped to them, a sandwich board for the lunch service with a question mark,
// a grown-up checking a phone on the way in with a child, and a bus stop whose display has no
// time to give. The notice is translated; nothing else has words.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const [strike, minimum] = { ca:['Vaga general', 'Serveis mínims'], es:['Huelga general', 'Servicios mínimos'], en:['General strike', 'Minimum services'] }[Astro.props.language];
// The railings either side of the gate, a bar every two units.
const bars = Array.from({ length:14 }, (_, i) => 1 + i * 2);
// The open gate's leaves, swung back against its posts.
const leaves = [30, 43.2] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="88" cy="9" r="3.8" style="fill:var(--sun)"/><g class="night"><circle cx="88" cy="9" r="3.8" style="fill:var(--sun)"/><circle cx="89.8" cy="8" r="3.4" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="2" y="7" width="15" height="6"/><use href="#cloud" x="82" y="18" width="13" height="5.2"/></g>
  <use href="#school-building" x="-12.5" y="-22" width="125" height="112.5"/>
  <rect y="47.4" width="100" height="2.6" style="fill:var(--wall-dark)"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none">
  <rect width="100" height="40" style="fill:var(--wall-dark)"/>
  <path d="M0 9h100M0 19h100M20 0v29M50 0v29M80 0v29" style="stroke:var(--wall);stroke-width:.4;opacity:.7"/>
  <rect y="29" width="100" height="11" style="fill:var(--steel)"/><rect y="28.6" width="100" height="1.2" style="fill:var(--white)"/>
  <g style="fill:var(--white);opacity:.9"><rect x="40" y="31" width="20" height="1.4"/><rect x="40" y="33.8" width="20" height="1.4"/><rect x="40" y="36.6" width="20" height="1.4"/></g>
</svg>
  <div class="piece" style="--x:12;--y:6;--w:76;--ar:76/15;--d:0"><svg viewBox="0 0 76 15">
    {/* The railings on a low wall, the gate open between its posts. */}
    <rect x="0" y="12" width="76" height="3" style="fill:var(--wall)"/><rect x="0" y="12" width="76" height=".6" style="fill:var(--wall-dark)"/>
    <path d={bars.map(x => `M${x} 2.6V12M${x + 48} 2.6V12`).join('')} style="stroke:var(--black);stroke-width:.5"/>
    <path d="M0 3.4h28M48 3.4h28M0 10.6h28M48 10.6h28" style="stroke:var(--black);stroke-width:.6"/>
    <g style="fill:var(--black)">{bars.map(x => <><circle cx={x} cy="2.4" r=".45"/><circle cx={x + 48} cy="2.4" r=".45"/></>)}</g>
    {leaves.map(x => <g style="stroke:var(--black);stroke-width:.4;opacity:.85"><path d={`M${x} 3.4h2.8M${x} 11h2.8M${x + .4} 3.4V11M${x + 1.4} 3.4V11M${x + 2.4} 3.4V11`}/></g>)}
    <g style="fill:var(--wall)"><rect x="27.4" y="1" width="2.4" height="14"/><rect x="46.2" y="1" width="2.4" height="14"/></g>
    <g style="fill:var(--wall-dark)"><rect x="27" y="0" width="3.2" height="1.2"/><rect x="45.8" y="0" width="3.2" height="1.2"/></g>
    {/* The school's notice, taped to the railings. */}
    <rect x="2" y="1.6" width="24" height="9.8" rx=".3" style="fill:var(--white)"/>
    <rect x="2" y="1.6" width="24" height="3.8" style="fill:var(--escola)"/>
    <text x="14" y="4.5" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:2.5px;fill:var(--white)">{strike}</text>
    <text x="14" y="8.3" text-anchor="middle" style="font-family:Georgia,serif;font-size:2.1px;fill:var(--black)">{minimum}</text>
    <path d="M6 10h16" style="stroke:var(--black);stroke-width:.3;opacity:.35"/>
    <g style="fill:var(--yellow);opacity:.75"><rect x="1.2" y=".9" width="3" height="1.2" transform="rotate(-20 2.7 1.5)"/><rect x="23.8" y=".9" width="3" height="1.2" transform="rotate(20 25.3 1.5)"/></g>
  </svg></div>
  <div class="piece" style="--x:17;--y:17;--w:10;--ar:10/12;--d:.12"><svg viewBox="0 0 10 12">
    {/* The lunch service's sandwich board: what it can offer that day is still to come. */}
    <path d="M1.4 12 2.6 1M8.6 12 7.4 1" style="stroke:var(--wood-dark);stroke-width:.7;stroke-linecap:round"/>
    <rect x="1.8" y="1" width="6.4" height="7.8" rx=".4" style="fill:var(--black);stroke:var(--wood);stroke-width:.6"/>
    <circle cx="5" cy="4" r="1.6" style="fill:none;stroke:var(--white);stroke-width:.35"/>
    <path d="M2.9 2.8v2.6M7.1 2.8v2.6" style="stroke:var(--white);stroke-width:.3;stroke-linecap:round"/>
    <text x="5" y="8.1" text-anchor="middle" style="font-family:'Young Serif',Georgia,serif;font-size:2.4px;fill:var(--yellow)">?</text>
  </svg></div>
  <div class="piece" style="--x:40;--y:30;--w:19;--ar:22/30;--d:.2"><svg viewBox="0 0 22 30">
    {/* A grown-up checks a phone for news on the way in, holding a child's hand. */}
    <g class="hop">
      <path d="M6.4 21.4 5.4 29M8.2 21.4l.8 7.6" style="fill:none;stroke:var(--black);stroke-width:1.7;stroke-linecap:round"/>
      <path d="M7.2 9.6c-2.6 0-3.8 2.2-4 6.4l-.2 5.8h8.4l-.2-5.8c-.2-4.2-1.4-6.4-4-6.4z" style="fill:var(--sea)"/>
      <path d="M4.4 12.8c-1 1.6-1.2 3-.4 3.8l2-.6" style="fill:none;stroke:var(--skin-5);stroke-width:1.2;stroke-linecap:round"/>
      <rect x="5.4" y="13.8" width="1.8" height="2.8" rx=".3" style="fill:var(--black)"/><rect x="5.65" y="14.1" width="1.3" height="2.2" style="fill:var(--window)"/>
      <path d="M10 12.8l1.6 5.8" style="fill:none;stroke:var(--skin-5);stroke-width:1.2;stroke-linecap:round"/>
      <circle cx="7.2" cy="6.6" r="2.8" style="fill:var(--skin-5)"/><path d="M4.4 6.8c-.4-2.4 1-4 2.8-4s3.2 1.6 2.8 4c-.4-1.2-1.6-2-2.8-2s-2.4.8-2.8 2z" style="fill:var(--hair-5)"/>
      <use href="#child" x="10" y="12" width="12" height="18" style="--clothes:var(--afa);--skin:var(--skin-6);--hair:var(--hair-4)"/>
      <path d="M13.6 20.2l-2-1.6M18.4 20.2l1.2 3.4" style="fill:none;stroke:var(--skin-6);stroke-width:1.2;stroke-linecap:round"/>
      <path d="M13.8 19.4v3.6M18.2 19.4v3.6" style="stroke:var(--classe);stroke-width:.6"/>
    </g>
  </svg></div>
  <div class="piece" style="--x:79;--y:26;--w:12;--ar:12/26;--d:.28"><svg viewBox="0 0 12 26">
    {/* The bus stop, its display with no time to give. */}
    <rect x="2.6" y="3" width=".9" height="23" style="fill:var(--steel)"/><rect x="1.4" y="25.4" width="3.2" height=".6" style="fill:var(--steel)"/>
    <circle cx="3" cy="3.2" r="2.8" style="fill:var(--red)"/>
    <rect x="1.6" y="1.9" width="2.8" height="2.4" rx=".4" style="fill:var(--white)"/><rect x="1.9" y="2.2" width="2.2" height=".9" style="fill:var(--red)"/>
    <rect x="3.4" y="8" width="8.2" height="4.6" rx=".4" style="fill:var(--black)"/>
    <text class="glow" x="7.5" y="11.2" text-anchor="middle" style="font-family:Georgia,serif;font-size:2.2px;fill:var(--orange)">-- min</text>
  </svg></div>
  <div class="piece" style="--x:4;--y:31;--w:12;--ar:18/30;--d:.36"><svg viewBox="0 0 18 30"><use href="#tree" width="18" height="30"/></svg></div>
</div>
