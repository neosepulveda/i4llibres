---
// The school's sports hall for psychomotricity: wall bars and a climbing rope on the wall, a mat,
// a bench with the socks the children need, a child balancing on a beam and a bouncing ball.
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--cream)"/>
  <rect y="34" width="100" height="16" style="fill:var(--sea-light);opacity:.35"/>
  <rect y="33.4" width="100" height="1" style="fill:var(--sea)"/>
  <g style="fill:var(--wood)"><rect x="6" y="4" width="1.6" height="30"/><rect x="22" y="4" width="1.6" height="30"/></g>
  <g style="fill:var(--wood-dark)"><rect x="6" y="7" width="17.6" height="1.1"/><rect x="6" y="11.4" width="17.6" height="1.1"/><rect x="6" y="15.8" width="17.6" height="1.1"/><rect x="6" y="20.2" width="17.6" height="1.1"/><rect x="6" y="24.6" width="17.6" height="1.1"/><rect x="6" y="29" width="17.6" height="1.1"/></g>
  <g class="swing part" style="transform-origin:50% 0"><path d="M38 0v30" style="stroke:var(--cardboard);stroke-width:1.4;stroke-linecap:round"/><path d="M38 6v24" style="fill:none;stroke:var(--wood-dark);stroke-width:.5;stroke-dasharray:1.2 1.2;opacity:.6"/><circle cx="38" cy="30.6" r="1.6" style="fill:var(--wood-dark)"/></g>
  <rect x="58" y="6" width="34" height="16" rx=".8" style="fill:var(--wood-dark)"/><rect x="59.2" y="7.2" width="31.6" height="13.6" style="fill:var(--sky)"/><path d="M69.7 7.2v13.6M80.3 7.2v13.6" style="stroke:var(--wood-dark);stroke-width:.7"/>
  <circle class="day" cx="85" cy="11" r="2.2" style="fill:var(--sun)"/><g class="night"><circle cx="85" cy="11" r="2.2" style="fill:var(--sun)"/><circle cx="86.2" cy="10.2" r="2" style="fill:var(--sky)"/></g>
  <use href="#cloud" class="day" x="60" y="9" width="12" height="5"/>
  <g style="fill:var(--red)"><circle cx="50" cy="26" r="3.4"/></g><circle cx="50" cy="26" r="3.4" style="fill:none;stroke:var(--white);stroke-width:.6"/><circle cx="50" cy="26" r="1.2" style="fill:var(--white)"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><rect width="100" height="40" style="fill:var(--court)"/><g style="fill:none;stroke:var(--white);stroke-width:.5;opacity:.8"><path d="M4 3h92v34H4z"/><circle cx="50" cy="20" r="9"/><path d="M50 3v34"/></g></svg>
  <div class="piece" style="--x:4;--y:10;--w:30;--ar:30/9;--d:0"><svg viewBox="0 0 30 9"><rect x="0" y="2" width="30" height="7" rx="1.2" style="fill:var(--sea-light)"/><rect x="0" y="2" width="30" height="2.4" rx="1" style="fill:var(--sea)"/><path d="M10 4.4v4.6M20 4.4v4.6" style="stroke:var(--white);stroke-width:.5;opacity:.6"/></svg></div>
  <div class="piece" style="--x:36;--y:7;--w:30;--ar:30/36;--d:.12"><svg viewBox="0 0 30 36">
    <g class="hop"><use href="#child" x="9" y="2" width="12" height="18" style="--clothes:var(--classe);--skin:var(--skin-5);--hair:var(--hair-3)"/><path d="M11.2 9 5 6.4M18.8 9l6.2-2.6" style="stroke:var(--skin-5);stroke-width:1.2;stroke-linecap:round"/><g style="fill:var(--white)"><rect x="12.4" y="17.6" width="1.9" height="2.6" rx=".6"/><rect x="15.7" y="17.6" width="1.9" height="2.6" rx=".6"/></g></g>
    <rect x="1" y="20" width="28" height="3" rx=".8" style="fill:var(--wood)"/><rect x="1" y="20" width="28" height="1" rx=".5" style="fill:var(--sand)"/>
    <g style="fill:var(--wood-dark)"><rect x="4" y="23" width="2.4" height="13"/><rect x="23.6" y="23" width="2.4" height="13"/></g>
  </svg></div>
  <div class="piece" style="--x:68;--y:17;--w:28;--ar:28/16;--d:.24"><svg viewBox="0 0 28 16">
    <rect x="0" y="6" width="28" height="3" rx=".6" style="fill:var(--wood)"/><rect x="0" y="6" width="28" height="1" style="fill:var(--sand)"/><g style="fill:var(--wood-dark)"><rect x="3" y="9" width="2" height="7"/><rect x="23" y="9" width="2" height="7"/></g>
    <g style="fill:var(--white);stroke:var(--black);stroke-width:.3"><path d="M8 6V1.6a1.2 1.2 0 0 1 2.4 0V4l2 1.2V6z"/><path d="M12.6 6V1.6a1.2 1.2 0 0 1 2.4 0V4l2 1.2V6z"/></g><g style="fill:var(--classe)"><rect x="8" y="1.2" width="2.4" height="1"/><rect x="12.6" y="1.2" width="2.4" height="1"/></g>
    <path d="M18 6V2.4h1.2v3.6z" style="fill:var(--red)"/><path d="M19.6 6V2.4h1.2v3.6z" style="fill:var(--yellow)"/>
  </svg></div>
  <div class="piece" style="--x:14;--y:28;--w:12;--ar:12/14;--d:.34"><svg viewBox="0 0 12 14"><g class="ball part"><circle cx="6" cy="8" r="4.6" style="fill:var(--yellow)"/><path d="M2 6.2q4 2.6 8 0M6 3.4v9.2" style="fill:none;stroke:var(--black);stroke-width:.4;opacity:.7"/></g></svg></div>
  <div class="piece" style="--x:74;--y:33;--w:16;--ar:16/8;--d:.42"><svg viewBox="0 0 16 8"><g style="fill:var(--orange)"><path d="M1 8 4 1h2L4 8z"/><path d="M9 8l3-7h2l-2 7z"/></g><g style="fill:var(--black);opacity:.5"><rect x="1" y="7.4" width="3" height=".6"/><rect x="9" y="7.4" width="3" height=".6"/></g></svg></div>
</div>
