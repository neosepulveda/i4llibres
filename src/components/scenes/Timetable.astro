---
import type { Language } from '../../lib/i18n';
interface Props { language: Language }
const days = { ca:['dl','dt','dc','dj','dv'], es:['L','M','X','J','V'], en:['Mo','Tu','We','Th','Fr'] }[Astro.props.language];
// One open wagon a day, with the activities from the latest class reminder.
const wagons = [['classe','var(--black)'],['sea-light','var(--black)'],['escola','#fff'],['afa','#fff'],['red','#fff']];
// Monday's library books, stood up like on a shelf: left, top, width, colour and lean.
const books = [[2.5,4.3,2.3,'escola',0],[5,3.1,2.7,'red',0],[7.9,4.9,2.1,'sea-light',0],[10.3,3.9,2.5,'afa',16]] as const;
---
<div class="backdrop"><svg viewBox="0 0 100 50" preserveAspectRatio="none">
  <rect width="100" height="50" style="fill:var(--sky)"/>
  <use href="#stars" class="night" width="100" height="50"/>
  <circle class="day" cx="16" cy="12" r="5" style="fill:var(--sun)"/><g class="night"><circle cx="16" cy="12" r="5" style="fill:var(--sun)"/><circle cx="18.4" cy="10.6" r="4.4" style="fill:var(--sky)"/></g>
  <g class="clouds"><use href="#cloud" x="56" y="6" width="20" height="8"/><use href="#cloud" x="30" y="16" width="13" height="5"/></g>
  <path d="M0 50V36c14-8 26-8 40-2s28-10 44-6 16 4 16 4v18z" style="fill:var(--grass-light)"/>
</svg></div>
<div class="floor"><svg viewBox="0 0 100 40" preserveAspectRatio="none"><rect width="100" height="40" style="fill:var(--grass)"/><rect y="15" width="100" height="5" style="fill:var(--sand-dark)"/><g style="fill:var(--wood-dark)"><rect x="2" y="15" width="2" height="5"/><rect x="10" y="15" width="2" height="5"/><rect x="18" y="15" width="2" height="5"/><rect x="26" y="15" width="2" height="5"/><rect x="34" y="15" width="2" height="5"/><rect x="42" y="15" width="2" height="5"/><rect x="50" y="15" width="2" height="5"/><rect x="58" y="15" width="2" height="5"/><rect x="66" y="15" width="2" height="5"/><rect x="74" y="15" width="2" height="5"/><rect x="82" y="15" width="2" height="5"/><rect x="90" y="15" width="2" height="5"/><rect x="98" y="15" width="2" height="5"/></g><g style="fill:var(--steel)"><rect y="15.6" width="100" height=".7"/><rect y="18.8" width="100" height=".7"/></g></svg>
  <div class="piece" style="--x:-2;--y:4;--w:104;--ar:104/9;--d:0"><svg viewBox="0 0 104 9"><path d="M0 9V5c12-6 24-5 36-1s22-6 36-3 22 5 32 1v7z" style="fill:var(--grass)"/><use href="#tree" x="12" y="-4" width="7" height="12"/><use href="#tree" x="78" y="-5" width="8" height="13"/></svg></div>
  <div class="piece train" style="--x:6;--y:18.6;--w:88;--ar:98/24;--d:.12"><svg viewBox="0 0 98 24">
    <defs><symbol id="union-flag" viewBox="-3 -1.8 6 3.6"><rect x="-3" y="-1.8" width="6" height="3.6" style="fill:var(--cloth)"/><path d="M-3-1.8 3 1.8M3-1.8-3 1.8" style="stroke:var(--white);stroke-width:.95"/><path d="M-3-1.8 3 1.8M3-1.8-3 1.8" style="stroke:var(--red);stroke-width:.35"/><path d="M0-1.8v3.6M-3 0h6" style="stroke:var(--white);stroke-width:1.25"/><path d="M0-1.8v3.6M-3 0h6" style="stroke:var(--red);stroke-width:.65"/></symbol></defs>
    <g class="train-cars" style="transform:translateX(calc((1 - min(var(--r,1),1)) * -90px))">
    {/* Each wagon carries its day from the class timetable. The wagons are drawn after, so they hide the lower half. */}
    <g class="cargo"><g class="library">{books.map(([x, top, width, colour, lean]) => <g transform={`rotate(${lean} ${x} 10.6)`}><rect x={x} y={top} width={width} height={+(10.6 - top).toFixed(1)} rx=".3" style={`fill:var(--${colour})`}/><g style="fill:var(--white);opacity:.75"><rect x={x} y={+(top + .8).toFixed(1)} width={width} height=".45"/><rect x={x} y={+(top + 1.7).toFixed(1)} width={width} height=".22"/></g></g>)}</g></g>
    <g class="cargo">
      <g class="english"><rect x="28.78" y="1.2" width=".45" height="9.4" style="fill:var(--wood-dark)"/><circle cx="29" cy="1.2" r=".45" style="fill:var(--gold)"/><use href="#union-flag" x="23.5" y="1.5" width="5.4" height="3.24"/></g>
    </g>
    <g class="cargo">
      <g class="english"><rect x="45.38" y="1.2" width=".45" height="9.4" style="fill:var(--wood-dark)"/><circle cx="45.6" cy="1.2" r=".45" style="fill:var(--gold)"/><use href="#union-flag" x="40.9" y="1.5" width="4.6" height="2.76"/></g>
      <g class="families"><g transform="translate(34.2 1.9) scale(.6)"><path d="M7 7.5c-3.1 0-4.2 2.5-4.9 13.3h9.8C11.2 10 10.1 7.5 7 7.5z" style="fill:var(--red)"/><circle cx="7" cy="4.3" r="2.5" style="fill:var(--skin-1)"/><path d="M4.5 4.4C4.3 2.4 5.5 1.3 7 1.3s2.7 1.1 2.5 3.1C8.8 3.5 8 3.1 7 3.1s-1.8.4-2.5 1.3z" style="fill:var(--hair-2)"/></g><use href="#child" x="39.4" y="4.25" width="6.6" height="9.9" style="--clothes:var(--sea-light);--skin:var(--skin-3);--hair:var(--hair-3)"/></g>
    </g>
    <g class="cargo">
      <g class="movement"><circle cx="53.2" cy="7.3" r="3" style="fill:var(--red)"/><path d="M50.2 7.3q3-2.25 6 0M53.2 4.3q-2.25 3 0 6" style="fill:none;stroke:var(--white);stroke-width:.6"/></g>
      <g class="music"><rect x="57.2" y="6.3" width="5" height="4.4" style="fill:var(--sea-light)"/><path d="M57.2 7.1l1.25 2.8 1.25-2.8 1.25 2.8 1.25-2.8" style="fill:none;stroke:var(--white);stroke-width:.3;stroke-linejoin:round"/><ellipse cx="59.7" cy="6.3" rx="2.5" ry=".75" style="fill:var(--white)"/><path d="M57.6 3.4 59.9 5.9M61.9 3.6 59.5 5.9" style="stroke:var(--wood-dark);stroke-width:.4;stroke-linecap:round"/>
        <g transform="translate(59.6 1.9) scale(.567)" style="fill:var(--black)"><ellipse cx="-1.55" cy="1.9" rx=".95" ry=".7" transform="rotate(-20 -1.55 1.9)"/><ellipse cx="1.65" cy="1.3" rx=".95" ry=".7" transform="rotate(-20 1.65 1.3)"/><path d="M-.72 1.75V-1.6M2.5 1.15V-2.5" style="stroke:var(--black);stroke-width:.42"/><path d="M-.93-1.55 2.71-2.55V-1.6L-.93-.6z"/></g></g>
    </g>
    <g class="cargo"><g class="phonology">
      {/* Speech bubbles and sound waves for Friday's phonological awareness. */}
      <path d="M68.2 1.4h7.6a1.2 1.2 0 0 1 1.2 1.2v3.6a1.2 1.2 0 0 1-1.2 1.2h-3l-2 2v-2h-2.6A1.2 1.2 0 0 1 67 6.2V2.6a1.2 1.2 0 0 1 1.2-1.2z" style="fill:var(--white)"/>
      <ellipse cx="69.5" cy="4.4" rx=".85" ry="1.1" style="fill:var(--red)"/>
      <path d="M71.5 3.3q1 1.1 0 2.2M73 2.6q1.8 1.8 0 3.6M74.5 2q2.4 2.4 0 4.8" style="fill:none;stroke:var(--cloth);stroke-width:.45;stroke-linecap:round"/>
    </g></g>
    {wagons.map(([colour, ink], i) => <g><rect x={1 + 16 * i} y="10" width="14.6" height="9" rx="1" style={`fill:var(--${colour})`}/><rect x={.6 + 16 * i} y="9.3" width="15.4" height="1.5" rx=".6" style={`fill:var(--${colour})`}/><rect x={.6 + 16 * i} y="9.3" width="15.4" height="1.5" rx=".6" style="fill:#000;opacity:.18"/><text x={8.3 + 16 * i} y="15.6" text-anchor="middle" style={`font-family:'Young Serif',Georgia,serif;font-size:3.6px;fill:${ink}`}>{days[i]}</text></g>)}
    <g><path d="M81 19V9h6V5h3v4h4.4c1.6 0 2.6 1 2.6 2.6V19z" style="fill:var(--cloth)"/><rect x="82.4" y="10.4" width="3.4" height="3.4" rx=".4" style="fill:var(--window)"/><path d="M88.4 5V2.6h3.8V5z" style="fill:var(--black)"/>
      <g style="fill:var(--white)"><circle class="smoke" cx="90.3" cy="1" r="1.6"/><circle class="smoke b" cx="90.3" cy="1" r="1.3"/><circle class="smoke c" cx="90.3" cy="1" r="1.1"/></g></g>
    <g style="fill:var(--black)"><circle cx="4.6" cy="20.2" r="2"/><circle cx="12" cy="20.2" r="2"/><circle cx="20.6" cy="20.2" r="2"/><circle cx="28" cy="20.2" r="2"/><circle cx="36.6" cy="20.2" r="2"/><circle cx="44" cy="20.2" r="2"/><circle cx="52.6" cy="20.2" r="2"/><circle cx="60" cy="20.2" r="2"/><circle cx="68.6" cy="20.2" r="2"/><circle cx="76" cy="20.2" r="2"/><circle cx="84.4" cy="20.2" r="2.6"/><circle cx="92.4" cy="20.2" r="2.6"/></g>
    <path d="M15.6 16h1.4M31.6 16H33M47.6 16H49M63.6 16H65M79.6 16H81" style="stroke:var(--black);stroke-width:.8"/>
  </g></svg></div>
  <div class="piece" style="--x:0;--y:34;--w:100;--ar:100/5;--d:.3"><svg viewBox="0 0 100 5"><g style="fill:var(--wood)"><path d="M0 1.4h100v.8H0zM0 3.2h100v.8H0z"/><path d="M4 0h1.4v5H4zM20 0h1.4v5H20zM36 0h1.4v5H36zM52 0h1.4v5H52zM68 0h1.4v5H68zM84 0h1.4v5H84z"/></g></svg></div>
</div>
