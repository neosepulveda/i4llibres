---
import { fileMeta } from '../lib/file-meta';
import type { Language } from '../lib/i18n';
interface Props { files: { src: string; title: string }[]; language: Language }
const { files, language } = Astro.props;
const assetUrl = (src: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${src}`;
---
{files.map(file => <a class="tab file-row" href={assetUrl(file.src)} download><span>{file.title}<small>{fileMeta(file.src, language)}</small></span><span class="tab-mark" aria-hidden="true"></span></a>)}
